{
  "name": "weeknd-dawn-edition",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4323",
    "build": "astro build",
    "preview": "astro preview --port 4323",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --exclude tests/unit/content-audit.test.ts",
    "audit:content": "vitest run tests/unit/content-audit.test.ts",
    "test:e2e": "playwright test",
    "budget": "node scripts/check-performance-budget.mjs",
    "covers:verify": "node scripts/refresh-album-covers.mjs --verify",
    "covers:refresh": "node scripts/refresh-album-covers.mjs",
    "fonts:header": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-header-font-subsets.mjs",
    "verify": "npm run lint && npm run format:check && npm run check && npm run audit:content && npm run test:unit && npm run build && npm run budget && npm run test:e2e",
    "check:dist": "node scripts/check-dist-i18n.mjs",
    "verify:core": "npm run lint && npm run format:check && npm run check && npm run test:unit && npm run build && npm run budget && npm run check:dist",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "assert:production-origin": "node scripts/assert-production-origin.mjs",
    "deploy": "npm run assert:production-origin && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "astro": "^6.4.8",
    "leaflet": "^1.9.4",
    "motion": "^13.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.20",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "subset-font": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
