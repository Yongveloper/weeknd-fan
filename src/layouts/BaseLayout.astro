---
import '@fontsource/bebas-neue';
import '@fontsource-variable/noto-sans-kr';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import { wordmark } from '../components/chrome/navigation';
import BackToTop from '../components/ui/BackToTop.astro';
import DawnSky from '../components/visual/DawnSky.astro';
import FilmGrain from '../components/visual/FilmGrain.astro';
import type { Locale } from '../lib/i18n/locales';
import { localePreferenceScript } from '../lib/i18n/preference';
import { alternateLinks } from '../lib/seo/alternates';
import { ui } from '../lib/i18n/ui';
import { headerFontAssets } from '../lib/fonts/headerFontAssets';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/back-to-top.css';
import '../styles/edition.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  spaceSky?: boolean;
  lunarSky?: boolean;
  cloudSky?: boolean;
  /** Page renders hotlinked Spotify album covers. */
  coverCdn?: boolean;
}

const {
  locale,
  title,
  description,
  ogImage = '/og/default.jpg',
  spaceSky = false,
  lunarSky = false,
  cloudSky = false,
  coverCdn = false,
} = Astro.props;
const strings = ui(locale);
// Only the deploy job sets this, so local builds, CI builds and the preview
// server the end-to-end tests drive stay out of the analytics data. The token
// is public: it ships in the markup of every page it measures.
// Cloudflare hands out the tag as type="module"; the beacon is an IIFE bundle,
// so defer runs it at the same point without depending on the CDN's CORS
// headers. Keep it that way.
const analyticsToken = import.meta.env.PUBLIC_ANALYTICS_TOKEN;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage, site);
const pageTitle = `${wordmark.name} | ${title}`;
const alternates = alternateLinks(Astro.url.pathname, site);
const ogLocale = locale === 'ko' ? 'ko_KR' : 'en_US';
const ogAlternates = locale === 'ko' ? ['en_US'] : ['ko_KR'];
// Both sky variants paint the same texture first; it is the LCP element on
// every page that has a sky (audit 2026-09-18 §3).
const preloadSkyTexture = cloudSky || lunarSky;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* First in <head>: it may replace this document, and everything below
        would be work thrown away. See lib/i18n/preference.ts. */
    }
    <script is:inline set:html={localePreferenceScript} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={wordmark.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {
      ogAlternates.map((value) => (
        <meta property="og:locale:alternate" content={value} />
      ))
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      preloadSkyTexture && (
        <link
          rel="preload"
          as="image"
          href="/visual/atmosphere/golden-cloud-bank-v3.webp"
          fetchpriority="high"
        />
      )
    }
    {
      coverCdn && (
        <link rel="preconnect" href="https://image-cdn-ak.spotifycdn.com" />
      )
    }
    {
      headerFontAssets.preloads.map((href) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={href}
          crossorigin
        />
      ))
    }
    <style is:inline set:html={headerFontAssets.css}></style>
    <title>{pageTitle}</title>
  </head>
  <body
    data-edition="dawn"
    data-space-sky={spaceSky || undefined}
    data-lunar-sky={lunarSky || undefined}
    data-cloud-sky={cloudSky || undefined}
  >
    {
      spaceSky && (
        <div
          class:list={['space-sky', { 'space-sky--lunar': lunarSky }]}
          aria-hidden="true"
        />
      )
    }
    {cloudSky && <DawnSky readingOnly />}
    <a class="skip-link" href="#content">{strings.chrome.skipToContent}</a>
    <SiteHeader locale={locale} />
    <main
      id="content"
      class:list={{ 'reading-surface': cloudSky }}
      tabindex="-1"
    >
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <BackToTop locale={locale} />
    <FilmGrain cover={lunarSky} />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/back-to-top.ts"></script>
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
