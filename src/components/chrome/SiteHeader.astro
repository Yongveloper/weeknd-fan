---
import { navigation, wordmark } from './navigation';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell-content site-header__inner">
    <a
      class="site-header__wordmark"
      href="/"
      aria-label="The Weeknd 고양 팬 가이드 홈"
    >
      <span aria-hidden="true">{wordmark.name}</span>
      <span class="site-header__edition" aria-hidden="true"
        >{wordmark.edition}</span
      >
    </a>
    <nav aria-label="주요 메뉴">
      <mobile-navigation>
        <details aria-label="주요 메뉴" open>
          <summary>메뉴</summary>
          <ul class="site-header__nav-list">
            {
              navigation.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    aria-current={pathname === href ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </mobile-navigation>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 14%, transparent);
    background: color-mix(in srgb, var(--night) 70%, transparent);
    backdrop-filter: blur(16px);
    view-transition-name: site-header;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    min-height: 5.25rem;
  }

  .site-header__wordmark {
    display: grid;
    flex: 0 0 auto;
    color: var(--ivory);
    /* Header aliases (BaseLayout preloads them, font-display: block) keep the
       chrome in the same face on every page; see src/lib/fonts. */
    font-family: 'Bebas Neue Header', var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    letter-spacing: 0.075em;
    line-height: 0.8;
    text-decoration: none;
  }

  .site-header__edition {
    margin-top: 0.45rem;
    color: var(--amber);
    font-family: 'Noto Sans KR Header', var(--font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    min-width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav-list a {
    position: relative;
    display: grid;
    place-items: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0.45rem 0.65rem;
    color: var(--ink-muted);
    font-family: 'Noto Sans KR Header', var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease-cinematic),
      background var(--motion-fast) var(--ease-cinematic);
  }

  .site-header__nav-list a::after {
    position: absolute;
    inset: auto 0.65rem 0.4rem;
    height: 2px;
    background: var(--amber);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-cinematic);
  }

  .site-header__nav-list a:hover,
  .site-header__nav-list a[aria-current='page'] {
    color: var(--ivory);
  }

  .site-header__nav-list a:hover::after,
  .site-header__nav-list a:focus-visible::after,
  .site-header__nav-list a[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (max-width: 44rem) {
    .site-header__inner {
      display: block;
      padding-block: 1rem 0;
    }

    details {
      margin-top: 0.5rem;
    }

    summary {
      display: grid;
      place-items: center;
      min-block-size: 44px;
      color: var(--ivory);
      font-family: 'Noto Sans KR Header', var(--font-body);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
    }

    .site-header__nav-list {
      display: grid;
      gap: 0;
      min-width: 0;
      padding-block: 0.5rem;
    }

    .site-header__nav-list a {
      justify-content: start;
    }

    .site-header__nav-list a::after {
      inset-inline: 0;
    }
  }

  @media (min-width: 44.0625rem) {
    summary {
      display: none;
    }
  }
</style>

<script>
  class MobileNavigation extends HTMLElement {
    private readonly mobileQuery = window.matchMedia('(max-width: 44rem)');
    private details: HTMLDetailsElement | null = null;

    private synchronizeMenu = () => {
      if (this.details) this.details.open = !this.mobileQuery.matches;
    };

    connectedCallback() {
      this.details = this.querySelector('details');
      if (!this.details) return;
      this.mobileQuery.addEventListener('change', this.synchronizeMenu);
      this.synchronizeMenu();
      this.dataset.ready = 'true';
    }

    disconnectedCallback() {
      this.mobileQuery.removeEventListener('change', this.synchronizeMenu);
    }
  }

  if (!customElements.get('mobile-navigation')) {
    customElements.define('mobile-navigation', MobileNavigation);
  }
</script>
