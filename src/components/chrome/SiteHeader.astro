---
const pathname = Astro.url.pathname;
const navigation = [
  { href: '/', label: '홈' },
  { href: '/discover/', label: 'The Weeknd' },
  { href: '/setlist/', label: '예상 셋리스트' },
  { href: '/goyang/', label: '고양 가이드' },
  { href: '/sources/', label: '출처·업데이트' },
];
---

<header class="site-header">
  <div class="shell-content site-header__inner">
    <a
      class="site-header__wordmark"
      href="/"
      aria-label="The Weeknd 고양 팬 가이드 홈"
    >
      <span aria-hidden="true">DAWNFOLD</span>
      <span class="site-header__edition" aria-hidden="true"
        >THE WEEKND · GOYANG 26</span
      >
    </a>
    <nav aria-label="주요 메뉴">
      <ul class="site-header__nav-list">
        {
          navigation.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={pathname === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 14%, transparent);
    background: color-mix(in srgb, var(--night) 70%, transparent);
    backdrop-filter: blur(16px);
    view-transition-name: site-header;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    min-height: 5.25rem;
  }

  .site-header__wordmark {
    display: grid;
    flex: 0 0 auto;
    color: var(--ivory);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    letter-spacing: 0.075em;
    line-height: 0.8;
    text-decoration: none;
  }

  .site-header__edition {
    margin-top: 0.45rem;
    color: var(--amber);
    font-family: var(--font-body);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  nav {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    min-width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav-list li {
    scroll-snap-align: start;
  }

  .site-header__nav-list a {
    position: relative;
    display: grid;
    place-items: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0.45rem 0.65rem;
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease-cinematic),
      background var(--motion-fast) var(--ease-cinematic);
  }

  .site-header__nav-list a::after {
    position: absolute;
    inset: auto 0.65rem 0.4rem;
    height: 2px;
    background: var(--amber);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-cinematic);
  }

  .site-header__nav-list a:hover,
  .site-header__nav-list a[aria-current='page'] {
    color: var(--ivory);
  }

  .site-header__nav-list a:hover::after,
  .site-header__nav-list a:focus-visible::after,
  .site-header__nav-list a[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (max-width: 44rem) {
    .site-header__inner {
      display: block;
      padding-block: 1rem 0;
    }

    nav {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter) 3rem;
      scroll-padding-inline: var(--gutter) 3rem;
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 var(--gutter),
        #000 calc(100% - 3rem),
        transparent
      );
    }
  }
</style>
