---
import type { Locale } from '../../lib/i18n/locales';
import { formatSeoulDate } from '../../lib/content/audit';
import { getConcert } from '../../lib/content/queries';
import { ui } from '../../lib/i18n/ui';
import { footerNavigationFor } from './navigation';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale);
const footerNavigation = footerNavigationFor(locale);
const concert = await getConcert(locale);
const lastVerified = formatSeoulDate(new Date(concert.data.lastVerifiedAt));

/** `<wbr>` after the local part so a narrow column breaks the address where
 *  a reader expects it, rather than mid-domain the way `overflow-wrap` would.
 *  Built as markup because whitespace between JSX children would render as a
 *  space inside the address. */
const credits = ['yongveloper99@gmail.com', 'rbp0324@gmail.com'].map(
  (email, index) => ({
    role:
      index === 0
        ? strings.chrome.credits.build
        : strings.chrome.credits.design,
    email,
    html: email.replace('@', '<wbr />@'),
  }),
);
---

<footer class="site-footer">
  <div class="shell-content site-footer__inner" data-enter-group>
    <div>
      <p class="eyebrow"><Wordmark /> / GOYANG 2026</p>
      <p class="site-footer__disclaimer">{strings.chrome.disclaimer}</p>
      <p class="site-footer__verified">
        {strings.chrome.verifiedPrefix}
        {lastVerified}
      </p>
    </div>
    <nav class="site-footer__nav" aria-label={strings.chrome.siteMap}>
      <ul>
        {
          footerNavigation.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="site-footer__ticket-link"
      href="https://tickets.interpark.com/contents/notice/detail/14180"
      target="_blank"
      rel="noreferrer"
    >
      {strings.chrome.officialTicketNotice}
      <span aria-hidden="true">↗</span>
    </a>
    <div class="site-footer__colophon">
      <p class="eyebrow">{strings.chrome.credits.label}</p>
      <ul class="site-footer__credits">
        {
          credits.map(({ role, email, html }) => (
            <li>
              <span class="site-footer__role">{role}</span>
              <a href={`mailto:${email}`} set:html={html} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-space);
    border-top: 1px solid color-mix(in srgb, var(--amber) 55%, transparent);
  }

  .site-footer__inner {
    display: grid;
    /* The nav and ticket columns are `auto`, so they hold their max-content
       width and the brand column absorbs every shortfall. Without a floor it
       collapsed to ~50px on tablets, breaking the disclaimer mid-word. The
       floor makes the nav take the squeeze instead, which it can: its list
       wraps. */
    grid-template-columns: minmax(min(100%, 18rem), 1fr) auto auto;
    gap: 2rem 3rem;
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .site-footer__disclaimer {
    margin-top: 0.5rem;
    color: var(--ivory);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
  }

  .site-footer__verified {
    margin-top: 0.5rem;
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a,
  .site-footer__ticket-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ivory);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .site-footer__nav a {
    color: var(--mist);
    text-decoration: none;
  }

  .site-footer__nav a:hover,
  .site-footer__nav a:focus-visible {
    color: var(--amber);
  }

  .site-footer__ticket-link {
    gap: 0.55rem;
  }

  .site-footer__colophon {
    grid-column: 1 / -1;
    padding-top: 1.35rem;
    border-top: 1px solid rgb(218 177 122 / 22%);
  }

  .site-footer__credits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 3rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__credits li {
    min-width: 0;
  }

  .site-footer__role {
    display: block;
    color: var(--mist);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .site-footer__credits a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
    color: var(--ivory);
    font-size: 0.85rem;
    font-weight: 450;
    text-decoration: none;
  }

  .site-footer__credits a:hover,
  .site-footer__credits a:focus-visible {
    color: var(--amber);
  }

  /* 64rem, not 48rem: the three-column row needs room for the brand column
     floor plus the nav and ticket columns at their content width. Below that
     the nav wrapped down to one item per line and the footer grew taller than
     the stacked layout it was avoiding. */
  @media (max-width: 64rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    .site-footer__credits {
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>
