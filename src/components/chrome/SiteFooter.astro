---
import { formatSeoulDate } from '../../lib/content/audit';
import { getConcert } from '../../lib/content/queries';
import { footerNavigation } from './navigation';
import Wordmark from './Wordmark.astro';

const concert = await getConcert();
const lastVerified = formatSeoulDate(new Date(concert.data.lastVerifiedAt));
---

<footer class="site-footer">
  <div class="shell-content site-footer__inner" data-enter-group>
    <div>
      <p class="eyebrow"><Wordmark /> / GOYANG 2026</p>
      <p class="site-footer__disclaimer">비공식·비영리 팬 가이드</p>
      <p class="site-footer__verified">공식 정보 마지막 확인 {lastVerified}</p>
    </div>
    <nav class="site-footer__nav" aria-label="사이트 지도">
      <ul>
        {
          footerNavigation.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="site-footer__ticket-link"
      href="https://tickets.interpark.com/contents/notice/detail/14180"
      target="_blank"
      rel="noreferrer"
    >
      공식 티켓 공지 보기 <span aria-hidden="true">↗</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-space);
    border-top: 1px solid color-mix(in srgb, var(--amber) 55%, transparent);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 2rem 3rem;
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .site-footer__disclaimer {
    margin-top: 0.5rem;
    color: var(--ivory);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
  }

  .site-footer__verified {
    margin-top: 0.5rem;
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a,
  .site-footer__ticket-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ivory);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .site-footer__nav a {
    color: var(--mist);
    text-decoration: none;
  }

  .site-footer__nav a:hover,
  .site-footer__nav a:focus-visible {
    color: var(--amber);
  }

  .site-footer__ticket-link {
    gap: 0.55rem;
  }

  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }
  }
</style>
