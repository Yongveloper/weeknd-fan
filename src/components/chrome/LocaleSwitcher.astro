---
import { LOCALES, type Locale } from '../../lib/i18n/locales';
import { localeHref, pathWithoutLocale } from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import { localeLabels } from './navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale);
const bare = pathWithoutLocale(Astro.url.pathname);
---

<nav class="locale-switcher" aria-label={strings.chrome.localeSwitcher}>
  <ul>
    {
      LOCALES.map((candidate) => (
        <li>
          <a
            hreflang={candidate}
            href={localeHref(candidate, bare)}
            lang={candidate}
            aria-current={candidate === locale ? 'true' : undefined}
          >
            {localeLabels[candidate]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* The switcher is a sibling of the primary menu, so it uses the primary
     menu's vocabulary exactly: same face, size and weight, muted until
     current, amber bar for the active one. Before this it rendered at the
     browser default — 16px/400 at full opacity against the nav's
     13px/700 at 70% — so the secondary control outweighed the primary one,
     and both links carried the default underline, which made `aria-current`
     invisible. */
  .locale-switcher {
    flex: 0 0 auto;
    border-inline-start: 1px solid
      color-mix(in srgb, var(--ivory) 16%, transparent);
    padding-inline-start: 0.5rem;
  }

  .locale-switcher ul {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .locale-switcher li {
    display: flex;
    align-items: center;
  }

  .locale-switcher li + li::before {
    margin-inline-end: 0.1rem;
    color: var(--ink-muted);
    content: '·';
  }

  .locale-switcher a {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: 44px;
    padding: 0.45rem 0.45rem;
    color: var(--ink-muted);
    font-family: 'Noto Sans KR Header', var(--font-body);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-cinematic);
  }

  .locale-switcher a::after {
    position: absolute;
    inset: auto 0.45rem 0.4rem;
    height: 2px;
    background: var(--amber);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-cinematic);
  }

  .locale-switcher a:hover,
  .locale-switcher a[aria-current='true'] {
    color: var(--ivory);
  }

  .locale-switcher a:hover::after,
  .locale-switcher a:focus-visible::after,
  .locale-switcher a[aria-current='true']::after {
    transform: scaleX(1);
  }

  @media (max-width: 44rem) {
    /* Inside the dropdown it is a row under the menu items, not a control
       beside them, so the rule moves from the inline start to the block
       start and the labels align with the links above. */
    .locale-switcher {
      border-inline-start: 0;
      border-block-start: 1px solid
        color-mix(in srgb, var(--ivory) 14%, transparent);
      margin-block-start: 0.35rem;
      padding-block-start: 0.35rem;
      padding-inline-start: 0;
    }

    .locale-switcher ul {
      justify-content: flex-start;
      padding-inline: var(--gutter);
    }
  }
</style>
