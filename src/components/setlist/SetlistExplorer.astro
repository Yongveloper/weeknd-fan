---
import AlbumCover from '../content/AlbumCover.astro';
import OfficialEmbed from '../content/OfficialEmbed.astro';
import SourceList from '../content/SourceList.astro';
import StatusBadge from '../content/StatusBadge.astro';
import Disclosure from '../ui/Disclosure.astro';
import type {
  AlbumRecord,
  SetlistRecord,
  ShowRecord,
  SourceRecord,
} from '../../lib/content/contracts';
import { findAlbumByTitle } from '../../lib/content/albums';
import {
  getSetlistEditorialMetadata,
  resolveSourceReferences,
} from '../../lib/content/queries';

interface Props {
  entries: SetlistRecord[];
  showRecords: ShowRecord[];
  sources: SourceRecord[];
  archivePublished: boolean;
  albums: AlbumRecord[];
}

const { entries, showRecords, sources, archivePublished, albums } = Astro.props;
const twoDigits = (value: number) => String(value).padStart(2, '0');
const dayLabel = (showDate: string) =>
  showDate.endsWith('-07') ? '1일차 공연 후 확인' : '2일차 공연 후 확인';
const editorial = getSetlistEditorialMetadata(entries);
---

<div class="setlist-explorer">
  {
    showRecords.length > 0 && (
      <section class="actual-setlist" aria-labelledby="actual-setlist-title">
        <p class="eyebrow">POST-SHOW RECORD</p>
        <h2 id="actual-setlist-title">공연 후 확인된 셋리스트</h2>
        {showRecords.map((record) => (
          <article>
            <div class="actual-setlist__heading">
              <h3>
                {archivePublished
                  ? record.data.showDate
                  : dayLabel(record.data.showDate)}
              </h3>
              <StatusBadge status={record.data.status} />
            </div>
            <ol>
              {record.data.songs
                .slice()
                .sort((a, b) => a.order - b.order)
                .map((song) => (
                  <li>
                    {song.title}
                    {song.note && ` — ${song.note}`}
                  </li>
                ))}
            </ol>
            <SourceList
              sources={resolveSourceReferences(record.data.sources, sources)}
            />
          </article>
        ))}
      </section>
    )
  }

  <section class="expected-setlist" aria-labelledby="expected-setlist-title">
    <div class="expected-setlist__heading">
      <div>
        <p class="eyebrow">A PATTERN, NOT A PROMISE</p>
        <h2 id="expected-setlist-title">이번 투어의 반복 패턴</h2>
      </div>
      <StatusBadge status="expected" />
    </div>
    <p class="expected-setlist__comparison">
      최근 2026년 공연 {editorial.observationCount}회 비교
    </p>
    <p class="expected-setlist__hint">
      곡을 누르면 관람 포인트·떼창·공식 듣기가 열립니다.
    </p>
    <a class="expected-setlist__poster" href="/share/setlist/"
      >셋리스트 포스터 만들기 <span aria-hidden="true">→</span></a
    >
    <ol class="expected-setlist__list">
      {
        entries.map((entry) => (
          <li>
            <Disclosure class="expected-setlist__item">
              <span slot="summary" class="expected-setlist__song">
                {twoDigits(entry.data.expectedOrder)} {entry.data.songTitle}
              </span>
              {/* Visual density hint only — album is announced in the expanded metadata below. */}
              <span
                slot="meta"
                class="expected-setlist__album-tag"
                aria-hidden="true"
              >
                {entry.data.album}
              </span>
              <div class="expected-setlist__detail">
                <div class="song-meta">
                  {(() => {
                    const album = findAlbumByTitle(albums, entry.data.album);
                    return album ? (
                      <AlbumCover album={album} size={48} />
                    ) : null;
                  })()}
                  <span class="song-meta__album">{entry.data.album}</span>
                  <span class="song-meta__pill">
                    신뢰도 {entry.data.confidence}
                  </span>
                  <StatusBadge status={entry.data.status} />
                </div>

                <div class="song-block">
                  <p class="eyebrow">BEFORE</p>
                  <h3>공연 전에 알면 좋은 한 문장</h3>
                  <p>{entry.data.summary}</p>
                </div>
                <div class="song-block">
                  <p class="eyebrow">ON STAGE</p>
                  <h3>무대에서 볼 것</h3>
                  <p>{entry.data.liveNote}</p>
                </div>
                <div class="song-block">
                  <p class="eyebrow">SING ALONG</p>
                  <h3>떼창 포인트</h3>
                  <p>{entry.data.singAlongNote}</p>
                </div>

                {entry.data.officialListenUrl && (
                  <div class="song-embed">
                    <OfficialEmbed
                      url={entry.data.officialListenUrl}
                      songTitle={entry.data.songTitle}
                    />
                  </div>
                )}

                <div class="song-sources">
                  <h3>출처</h3>
                  <SourceList
                    sources={resolveSourceReferences(
                      entry.data.observedIn,
                      sources,
                    )}
                  />
                </div>
              </div>
            </Disclosure>
          </li>
        ))
      }
    </ol>
  </section>
</div>

<style>
  .setlist-explorer {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
  }

  .expected-setlist,
  .actual-setlist {
    max-width: 62rem;
  }

  .expected-setlist__heading,
  .actual-setlist__heading {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: end;
    justify-content: space-between;
  }

  h2 {
    margin: 0;
  }

  .expected-setlist__comparison {
    margin: 1rem 0 1.5rem;
    color: var(--mist);
    font-weight: 800;
  }

  .expected-setlist__poster {
    color: var(--ivory);
    font-weight: 900;
  }

  .expected-setlist__hint {
    margin: -1rem 0 1rem;
    color: var(--amber);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .expected-setlist__list,
  .actual-setlist ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .expected-setlist__list :global(.expected-setlist__item),
  .actual-setlist article {
    border-top: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
  }

  .expected-setlist__list :global(.expected-setlist__item) {
    border-bottom: 0;
  }

  .expected-setlist__list li:last-child :global(.expected-setlist__item),
  .actual-setlist article:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
  }

  .expected-setlist__song {
    font-size: clamp(1.05rem, 2.4vw, 1.45rem);
  }

  .expected-setlist__album-tag {
    flex-shrink: 0;
    overflow: hidden;
    max-width: 40%;
    color: var(--mist);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-align: end;
    text-overflow: ellipsis;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .expected-setlist__detail {
    display: grid;
    gap: 1.25rem;
    padding: 0 0.2rem;
  }

  .song-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
    color: var(--ivory);
    font-size: 0.84rem;
    font-weight: 800;
  }

  .song-meta__album {
    font-weight: 900;
  }

  .song-meta__pill {
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--mist) 40%, transparent);
    border-radius: 999px;
    color: var(--mist);
    font-size: 0.76rem;
  }

  .song-block {
    display: grid;
    gap: 0.35rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--amber);
  }

  .song-block .eyebrow {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.18em;
  }

  .song-block h3 {
    margin: 0;
    color: var(--ivory);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .song-block p:not(.eyebrow) {
    margin: 0;
    color: var(--mist);
  }

  .song-embed {
    padding-inline-start: calc(0.9rem + 2px);
  }

  .song-sources {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }

  .song-sources h3 {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .song-sources :global(.source-list) {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--mist) 60%, transparent);
  }

  /* .song-sources doubled to out-specificity SourceList's own
     `.source-list a { color: var(--ivory) }` rule, which ties otherwise. */
  .song-sources.song-sources :global(.source-list a) {
    color: var(--mist);
  }

  .actual-setlist article {
    padding: 1.25rem 0;
  }

  .actual-setlist h3 {
    margin: 0.85rem 0 0;
    color: var(--amber);
    font-size: 0.85rem;
  }

  .actual-setlist ol {
    gap: 0.35rem;
    margin: 1rem 0;
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .actual-setlist li::marker {
    color: var(--amber);
    font-family: var(--font-display);
  }
</style>
