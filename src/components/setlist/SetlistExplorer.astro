---
import AlbumCover from '../content/AlbumCover.astro';
import OfficialEmbed from '../content/OfficialEmbed.astro';
import SourceList from '../content/SourceList.astro';
import StatusBadge from '../content/StatusBadge.astro';
import Disclosure from '../ui/Disclosure.astro';
import type {
  AlbumRecord,
  SetlistRecord,
  ShowRecord,
  SourceRecord,
} from '../../lib/content/contracts';
import { findAlbumByTitle } from '../../lib/content/albums';
import { resolveSourceReferences } from '../../lib/content/queries';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
  entries: SetlistRecord[];
  showRecords: ShowRecord[];
  sources: SourceRecord[];
  archivePublished: boolean;
  albums: AlbumRecord[];
}

const { locale, entries, showRecords, sources, archivePublished, albums } =
  Astro.props;
const strings = ui(locale).setlist.explorer;
const twoDigits = (value: number) => String(value).padStart(2, '0');
const dayLabel = (showDate: string) =>
  strings.dayVerified.replace('{day}', showDate.endsWith('-07') ? '1' : '2');
const countShown = (
  entries.length === 1 ? strings.countShown.one : strings.countShown.other
).replace('{count}', String(entries.length));
const albumsInSetlist = [
  ...new Set(entries.map((entry) => entry.data.album)),
].sort((left, right) => left.localeCompare(right));
const hasEssentialSet =
  entries.filter((entry) => entry.data.essentialOrder !== undefined).length ===
  10;
---

<div class="setlist-explorer">
  {
    showRecords.length > 0 && (
      <section class="actual-setlist" aria-labelledby="actual-setlist-title">
        <p class="eyebrow">POST-SHOW RECORD</p>
        <h2 id="actual-setlist-title">{strings.actualHeading}</h2>
        {showRecords.map((record) => (
          <article>
            <div class="actual-setlist__heading">
              <h3>
                {archivePublished
                  ? record.data.showDate
                  : dayLabel(record.data.showDate)}
              </h3>
              <StatusBadge locale={locale} status={record.data.status} />
            </div>
            <ol>
              {record.data.songs
                .slice()
                .sort((a, b) => a.order - b.order)
                .map((song) => (
                  <li>
                    {song.title}
                    {song.note && ` — ${song.note}`}
                  </li>
                ))}
            </ol>
            <SourceList
              locale={locale}
              sources={resolveSourceReferences(record.data.sources, sources)}
            />
          </article>
        ))}
      </section>
    )
  }

  <section class="expected-setlist" aria-label={strings.expectedListAriaLabel}>
    <form class="setlist-filter" data-setlist-filter hidden>
      <label class="setlist-filter__search">
        <span>{strings.searchLabel}</span>
        <input
          type="search"
          name="q"
          data-setlist-query
          placeholder={strings.searchPlaceholder}
          autocomplete="off"
        />
      </label>
      <label class="setlist-filter__album">
        <span>{strings.albumFilterLabel}</span>
        <select name="album" data-setlist-album>
          <option value="">{strings.allAlbumsOption}</option>
          {
            albumsInSetlist.map((album) => (
              <option value={album}>{album}</option>
            ))
          }
        </select>
      </label>
      {
        hasEssentialSet && (
          <div
            class="setlist-filter__views"
            aria-label={strings.viewsAriaLabel}
          >
            <button type="button" data-setlist-view="all" aria-pressed="true">
              {strings.viewAll}
            </button>
            <button
              type="button"
              data-setlist-view="essential"
              aria-pressed="false"
            >
              {strings.viewEssential}
            </button>
          </div>
        )
      }
      <div class="setlist-filter__footer">
        <p
          class="setlist-filter__count"
          data-setlist-count
          data-count-one={strings.countShown.one}
          data-count-other={strings.countShown.other}
          aria-live="polite"
          role="status"
          tabindex="-1"
        >
          {countShown}
        </p>
        <button type="button" data-setlist-reset>{strings.resetButton}</button>
      </div>
    </form>
    <ol class="expected-setlist__list" data-setlist-list>
      {
        entries.map((entry) => (
          <li
            data-song-id={entry.id}
            data-song-title={entry.data.songTitle.toLocaleLowerCase()}
            data-song-album={entry.data.album}
            data-essential-order={entry.data.essentialOrder ?? ''}
          >
            <Disclosure
              locale={locale}
              motion="fast"
              class="expected-setlist__item"
            >
              <span slot="summary" class="expected-setlist__song">
                {twoDigits(entry.data.expectedOrder)} {entry.data.songTitle}
              </span>
              {/* Visual density hint only — album is announced in the expanded metadata below. */}
              <span
                slot="meta"
                class="expected-setlist__album-tag"
                aria-hidden="true"
              >
                {entry.data.album}
              </span>
              <div class="expected-setlist__detail">
                <div class="song-meta">
                  {(() => {
                    const album = findAlbumByTitle(albums, entry.data.album);
                    return album ? (
                      <AlbumCover locale={locale} album={album} size={48} />
                    ) : null;
                  })()}
                  <span class="song-meta__album">{entry.data.album}</span>
                  <span class="song-meta__pill">
                    {strings.confidenceLabel.replace(
                      '{level}',
                      entry.data.confidence,
                    )}
                  </span>
                </div>

                <div class="song-block">
                  <p class="eyebrow">BEFORE</p>
                  <h3>{strings.beforeHeading}</h3>
                  <p>{entry.data.summary}</p>
                </div>
                <div class="song-block">
                  <p class="eyebrow">ON STAGE</p>
                  <h3>{strings.onStageHeading}</h3>
                  <p>{entry.data.liveNote}</p>
                </div>
                <div class="song-block">
                  <p class="eyebrow">SING ALONG</p>
                  <h3>{strings.singAlongHeading}</h3>
                  <p>{entry.data.singAlongNote}</p>
                </div>

                {entry.data.officialListenUrl && (
                  <div class="song-embed">
                    <OfficialEmbed
                      locale={locale}
                      url={entry.data.officialListenUrl}
                      songTitle={entry.data.songTitle}
                    />
                  </div>
                )}

                <div class="song-sources">
                  <h3>{strings.sourcesHeading}</h3>
                  <SourceList
                    locale={locale}
                    sources={resolveSourceReferences(
                      entry.data.observedIn,
                      sources,
                    )}
                  />
                </div>
              </div>
            </Disclosure>
          </li>
        ))
      }
    </ol>
    <p class="setlist-filter__empty" data-setlist-empty hidden>
      {strings.noResults}
    </p>
  </section>
</div>

<script src="../../scripts/setlist-filter.ts"></script>

<style>
  .setlist-explorer {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
  }

  .expected-setlist,
  .actual-setlist {
    max-width: 62rem;
  }

  .actual-setlist__heading {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: end;
    justify-content: space-between;
  }

  h2 {
    margin: 0;
  }

  .setlist-filter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.7fr);
    gap: 0.8rem;
    align-items: end;
    margin: 0 0 1rem;
    min-width: 0;
  }

  .setlist-filter label,
  .setlist-filter input,
  .setlist-filter select,
  .setlist-filter__views,
  .setlist-filter > button {
    min-width: 0;
    max-width: 100%;
  }

  .setlist-filter input,
  .setlist-filter select {
    width: 100%;
  }

  .setlist-filter label {
    display: grid;
    gap: 0.35rem;
    color: var(--mist);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .setlist-filter input,
  .setlist-filter select,
  .setlist-filter button {
    min-height: 44px;
    border: 1px solid color-mix(in srgb, var(--mist) 45%, transparent);
    border-radius: 0.25rem;
    background: rgb(12 12 10 / 35%);
    color: var(--ivory);
    font: inherit;
  }

  .setlist-filter input,
  .setlist-filter select {
    padding-inline: 0.75rem;
  }

  .setlist-filter button {
    padding-inline: 0.9rem;
    cursor: pointer;
    font-weight: 800;
  }

  .setlist-filter button[aria-pressed='true'] {
    border-color: var(--amber);
    color: var(--amber);
  }

  .setlist-filter :is(input, select, button):focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 2px;
  }

  .setlist-filter__views {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .setlist-filter__footer {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .setlist-filter__footer button {
    border-color: transparent;
    background: transparent;
    color: var(--mist);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .setlist-filter__footer button:hover {
    color: var(--amber);
  }

  .setlist-filter__count {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--amber);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .setlist-filter__empty {
    margin: 1rem 0 0;
    color: var(--mist);
    font-weight: 800;
  }

  .expected-setlist__list,
  .actual-setlist ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .expected-setlist__list :global(.expected-setlist__item),
  .actual-setlist article {
    border-top: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
  }

  .expected-setlist__list :global(.expected-setlist__item) {
    border-bottom: 0;
  }

  .expected-setlist__list li:last-child :global(.expected-setlist__item),
  .actual-setlist article:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
  }

  .expected-setlist__song {
    flex: 1 1 auto;
    font-size: clamp(1.05rem, 2.4vw, 1.45rem);
  }

  /* Never truncated: a clipped "hurry up tomorr…" carries no information.
     Inline on wide screens; drops under the title on narrow ones. */
  .expected-setlist__album-tag {
    flex: 0 0 auto;
    color: var(--mist);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: lowercase;
    white-space: nowrap;
  }

  @media (max-width: 42rem) {
    .setlist-filter {
      grid-template-columns: 1fr;
    }

    .expected-setlist__list :global(.expected-setlist__item > summary) {
      flex-wrap: wrap;
      row-gap: 0.1rem;
    }

    .expected-setlist__album-tag {
      flex: 1 1 100%;
      order: 3;
      white-space: normal;
    }
  }

  .expected-setlist__detail {
    display: grid;
    gap: 1.25rem;
    padding: 0 0.2rem;
  }

  .song-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
    color: var(--ivory);
    font-size: 0.84rem;
    font-weight: 800;
  }

  /* A long album name has to wrap inside its own box. Left at its natural
     width it pushed the confidence pill onto a second row on those songs only. */
  .song-meta__album {
    flex: 1 1 0;
    min-width: 0;
    font-weight: 900;
  }

  .song-meta__pill {
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--mist) 40%, transparent);
    border-radius: 999px;
    color: var(--mist);
    font-size: 0.76rem;
  }

  .song-block {
    display: grid;
    gap: 0.35rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--amber);
  }

  .song-block .eyebrow {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.18em;
  }

  .song-block h3 {
    margin: 0;
    color: var(--ivory);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .song-block p:not(.eyebrow) {
    margin: 0;
    color: var(--mist);
  }

  .song-embed {
    padding-inline-start: calc(0.9rem + 2px);
  }

  .song-sources {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }

  .song-sources h3 {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .song-sources :global(.source-list) {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--mist) 60%, transparent);
  }

  /* .song-sources doubled to out-specificity SourceList's own
     `.source-list a { color: var(--ivory) }` rule, which ties otherwise. */
  .song-sources.song-sources :global(.source-list a) {
    color: var(--mist);
  }

  .actual-setlist article {
    padding: 1.25rem 0;
  }

  .actual-setlist h3 {
    margin: 0.85rem 0 0;
    color: var(--amber);
    font-size: 0.85rem;
  }

  .actual-setlist ol {
    gap: 0.35rem;
    margin: 1rem 0;
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .actual-setlist li::marker {
    color: var(--amber);
    font-family: var(--font-display);
  }

  @media (max-width: 48rem) {
    .setlist-filter {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
