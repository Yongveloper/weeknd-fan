---
import MoonLight from './MoonLight.astro';
interface Props {
  readingOnly?: boolean;
}
const { readingOnly = false } = Astro.props;
---

{
  !readingOnly && (
    <div class="dawn-sky__eclipse" aria-hidden="true">
      <div class="dawn-sky__occlusion" />
      <MoonLight />
    </div>
  )
}
<dawn-sky
  aria-hidden="true"
  data-state="still"
  data-surface={readingOnly ? 'reading' : 'cover'}
>
  <div class="dawn-sky__still">
    <img
      src="/visual/atmosphere/golden-cloud-bank-v3.webp"
      alt=""
      width="1536"
      height="1024"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <canvas class="dawn-sky__clouds" aria-hidden="true"></canvas>
</dawn-sky>
<canvas class="dawn-sky__foreground" aria-hidden="true"></canvas>

<script>
  import '../../scripts/dawn-sky';
</script>

<style>
  /* The reading sky is pinned to the viewport. The large viewport height, not
     the dynamic one: a collapsing mobile URL bar otherwise resizes the sky
     mid-scroll (measured at 684 / 762 / 792 on iOS in one flick), and every
     change reallocates the canvas and resets the scene. Sized to the tallest
     viewport, the bottom strip is simply cropped while the bar is showing. */
  dawn-sky {
    position: fixed;
    inset: 0;
    display: block;
    height: 100lvh;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }
  /* The cover sky belongs to the hero and scrolls away with it, so it never
     has to chase the page from JavaScript. It reaches up behind the
     transparent header by the hero's own top offset, which keeps every
     composition offset below expressed in the same coordinates as before:
     the viewport at scroll 0. */
  dawn-sky[data-surface='cover'],
  dawn-sky[data-surface='cover'] + .dawn-sky__foreground,
  .dawn-sky__eclipse {
    position: absolute;
    inset: calc(-1 * var(--hero-origin)) 0 0;
    height: auto;
  }
  .dawn-sky__still {
    filter: hue-rotate(-8deg);
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  dawn-sky[data-surface='cover'] .dawn-sky__still::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(100% - var(--hero-frame-right) - var(--hero-frame) * 1.064995);
    top: calc(
      var(--hero-origin) + var(--hero-stage) * 0.86 - var(--hero-frame) *
        0.21288
    );
    width: calc(var(--hero-frame) * 0.55878);
    height: calc(var(--hero-frame) * 0.42576);
    background: url('/visual/atmosphere/golden-cloud-bank-v3.webp') 9.09%
      71.26% / 294.12% 257.35%;
    mix-blend-mode: screen;
    opacity: 0.75;
    mask-image:
      linear-gradient(90deg, transparent, #000 19%, #000 81%, transparent),
      linear-gradient(transparent, #000 14%, #000 86%, transparent);
    mask-composite: intersect;
  }
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100lvh;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
  }
  .dawn-sky__clouds {
    position: absolute;
    inset: 0;
    height: 100%;
    z-index: 1;
  }
  dawn-sky[data-renderer='webgl'] .dawn-sky__clouds,
  dawn-sky[data-renderer='webgl'] + canvas {
    opacity: 1;
  }
  dawn-sky[data-state='loading'] .dawn-sky__still {
    filter: brightness(0.15) saturate(0.3) hue-rotate(-8deg);
  }
  dawn-sky[data-surface='cover'][data-state='loading'] .dawn-sky__still {
    opacity: 0;
  }
  .dawn-sky__still {
    mask-image:
      radial-gradient(
        circle calc(var(--hero-frame) * 0.3104375) at
          calc(100% - var(--hero-frame-right) - var(--hero-frame) / 2)
          calc(
            var(--hero-origin) + var(--hero-frame-top) + var(--hero-frame) / 2
          ),
        transparent 78%,
        rgb(0 0 0 / 8%) 98%,
        #000 125%
      ),
      linear-gradient(
        90deg,
        rgb(0 0 0 / 38%) 20%,
        rgb(0 0 0 / 70%) 65%,
        #000 95%
      ),
      linear-gradient(#000 55%, rgb(0 0 0 / 90%) 75%);
    mask-composite: intersect;
  }
  /* The lowest cover layer. Its opaque night backs the whole hero extent, so
     the fixed reading sky behind the page never shows through the cover's
     translucent clouds or the opening around the moon. */
  .dawn-sky__eclipse {
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #000;
  }
  .dawn-sky__eclipse :global(moon-light) {
    position: absolute;
    top: calc(var(--hero-origin) + var(--hero-frame-top));
    right: var(--hero-frame-right);
  }
  .dawn-sky__occlusion {
    position: absolute;
    top: calc(
      var(--hero-origin) + var(--hero-frame-top) + var(--hero-frame) * 0.1895625
    );
    right: calc(var(--hero-frame-right) + var(--hero-frame) * 0.1895625);
    width: calc(var(--hero-frame) * 0.620875);
    aspect-ratio: 1;
    background: #000;
    border-radius: 50%;
  }
  dawn-sky[data-renderer='webgl'] .dawn-sky__still,
  dawn-sky[data-renderer='webgl'] .dawn-sky__reading-still {
    opacity: 0;
  }
  dawn-sky[data-surface='reading'] .dawn-sky__still {
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 38%), #000);
  }
  dawn-sky[data-surface='reading'] .dawn-sky__still::after {
    display: none;
  }
  img {
    position: absolute;
    width: 130%;
    max-width: none;
    height: 110%;
    left: -15%;
    top: 10%;
    object-fit: fill;
    mix-blend-mode: screen;
    filter: saturate(0.95) sepia(0.18) brightness(0.85);
    mask-image: linear-gradient(transparent, #000 22%, #000 85%, transparent);
  }
  @media (min-width: 42.001rem) {
    img {
      filter: saturate(0.85) sepia(0.12) brightness(1.08);
    }
    .dawn-sky__still::after {
      content: '';
      position: absolute;
      top: calc(
        var(--hero-origin) + var(--hero-frame-top) + var(--hero-frame) *
          0.6862625
      );
      left: calc(100% - var(--hero-frame-right) - var(--hero-frame) * 1.05);
      width: calc(var(--hero-frame) * 1.1);
      height: calc(var(--hero-frame) * 0.44);
      background: url('/visual/atmosphere/golden-cloud-bank-v3.webp') center /
        100% 180% no-repeat;
      mix-blend-mode: screen;
      opacity: 0.528;
      filter: saturate(0.85) brightness(1.18) contrast(1.1);
      mask-image:
        linear-gradient(transparent, #000 18%, #000 65%, transparent),
        linear-gradient(
          105deg,
          #000 12%,
          rgb(0 0 0 / 62%) 34%,
          #000 51%,
          rgb(0 0 0 / 72%) 78%,
          #000
        );
      mask-composite: intersect;
    }
  }
  @media (max-width: 42rem) {
    dawn-sky[data-surface='cover'] .dawn-sky__still::before {
      left: calc(100% - var(--hero-frame-right) - var(--hero-frame) * 0.953238);
    }
    img {
      width: 230%;
      left: -75%;
      top: 30%;
      height: 85%;
    }
  }
</style>
