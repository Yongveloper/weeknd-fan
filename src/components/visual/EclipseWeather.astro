---
const bank = '/visual/atmosphere/golden-cloud-bank-v3.webp';
---

<div class="eclipse-weather" aria-hidden="true">
  <div class="eclipse-weather__bank eclipse-weather__bank--far">
    <img src={bank} width="1536" height="1024" alt="" decoding="async" />
  </div>
  <div class="eclipse-weather__bank eclipse-weather__bank--front">
    <img src={bank} width="1536" height="1024" alt="" decoding="async" />
  </div>
  <div class="eclipse-weather__rays"></div>
  <div class="eclipse-weather__wisp">
    <img
      src="/visual/atmosphere/diffuse-haze-v2.webp"
      width="1280"
      height="853"
      alt=""
      decoding="async"
    />
  </div>
</div>
