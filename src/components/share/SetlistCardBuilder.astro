---
import StatusBadge from '../content/StatusBadge.astro';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { ARTIST } from '../../lib/i18n/proper-nouns';

interface Props {
  locale: Locale;
  version: string;
  songs: string[];
  shareUrl: string;
  archivePublished: boolean;
}
const { locale, version, songs, shareUrl, archivePublished } = Astro.props;
const updated = version.replaceAll('-', '.');
const strings = ui(locale).share;
const countKey = songs.length === 1 ? 'one' : 'other';
const lead = strings.setlist.lead[countKey].replace(
  '{count}',
  String(songs.length),
);
const songsCount = strings.setlist.songsCount[countKey].replace(
  '{count}',
  String(songs.length),
);
const basisValue = strings.setlist.basisValue.replace('{date}', updated);
const shareTitle = strings.setlist.shareTitle.replace('{artist}', ARTIST);
const clipboardText = strings.setlist.clipboardText.replace('{artist}', ARTIST);
---

<section
  class="share-builder"
  data-setlist-builder
  data-version={version}
  data-songs={JSON.stringify(songs)}
  data-msg-image-load-failed={strings.errors.imageLoadFailed}
  data-msg-canvas-unavailable={strings.errors.canvasUnavailable}
  data-msg-export-failed={strings.errors.exportFailed}
  data-copy-fallback-template={strings.common.copyFallback}
  data-copied-status={strings.common.copiedStatus}
  data-generating-status={strings.common.generatingStatus}
  data-saved-status={strings.setlist.savedStatus}
  data-share-label={strings.common.shareLabel}
  data-share-title={shareTitle}
  data-shared-status={strings.setlist.sharedStatus}
  data-share-cancelled={strings.common.shareCancelled}
  data-share-failed={strings.common.shareFailed}
  data-clipboard-text-template={clipboardText}
>
  <header>
    <h1>SETLIST POSTER</h1>
    {!archivePublished && <StatusBadge locale={locale} status="expected" />}
    <p class="lead">
      {lead}
    </p>
  </header>

  <div class="share-builder__grid">
    <figure class="card-preview">
      <canvas
        data-preview
        width="1080"
        height="1638"
        role="img"
        aria-label={strings.setlist.previewAriaLabel}
      >
        {strings.setlist.previewFallback}
      </canvas>
      <figcaption>
        {strings.setlist.previewCaption}
        <a href="/downloads/into-dawn-poster-original.png" download
          >{strings.common.originalPngLabel}</a
        >
      </figcaption>
    </figure>

    <div class="share-builder__controls">
      <dl class="card-facts">
        <div>
          <dt>{strings.setlist.songsIncludedLabel}</dt>
          <dd>{songsCount}</dd>
        </div>
        <div>
          <dt>{strings.setlist.basisLabel}</dt>
          <dd>{basisValue}</dd>
        </div>
      </dl>

      <button type="button" data-download-setlist
        >{strings.setlist.downloadButton}</button
      >
      <p class="privacy-note">
        {strings.setlist.privacyNote}
      </p>
      <p class="status" aria-live="polite" data-status></p>
      <p class="error" role="alert" hidden data-error></p>

      <div class="share-fallback">
        <p class="share-fallback__title">{strings.common.fallbackHeading}</p>
        <div class="share-fallback__actions">
          <a href="/og/default.jpg">{strings.common.fallbackImageLink}</a>
          <button type="button" data-copy-share
            >{strings.common.fallbackCopyButton}</button
          >
        </div>
        <code data-share-url>{shareUrl}</code>
      </div>

      <a class="share-builder__back" href="/setlist/"
        >{strings.setlist.backLink} <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
</section>

<script>
  import { buildSetlistCardLayout } from '../../lib/share/buildSetlistCardLayout';
  import { renderCommands } from '../../lib/share/canvas';
  import { downloadBlob } from '../../lib/share/download';

  document
    .querySelectorAll<HTMLElement>('[data-setlist-builder]')
    .forEach((root) => {
      const button = root.querySelector<HTMLButtonElement>(
        '[data-download-setlist]',
      );
      const preview = root.querySelector<HTMLCanvasElement>('[data-preview]');
      const status = root.querySelector<HTMLElement>('[data-status]');
      const error = root.querySelector<HTMLElement>('[data-error]');
      const copyShare =
        root.querySelector<HTMLButtonElement>('[data-copy-share]');
      const shareUrl = root.querySelector<HTMLElement>('[data-share-url]');
      let isGenerating = false;
      let shareButton: HTMLButtonElement | undefined;
      if (!button || !status || !error) return;

      // Localized copy comes in as data-* so this script never imports the
      // ui dictionary — two of them would land in the client JS budget.
      const messages = {
        imageLoadFailed: root.dataset.msgImageLoadFailed ?? '',
        canvasUnavailable: root.dataset.msgCanvasUnavailable ?? '',
        exportFailed: root.dataset.msgExportFailed ?? '',
      };
      const copyFallbackTemplate = root.dataset.copyFallbackTemplate ?? '';
      const copiedStatus = root.dataset.copiedStatus ?? '';
      const generatingStatus = root.dataset.generatingStatus ?? '';
      const savedStatus = root.dataset.savedStatus ?? '';
      const shareLabel = root.dataset.shareLabel ?? '';
      const shareTitle = root.dataset.shareTitle ?? '';
      const sharedStatus = root.dataset.sharedStatus ?? '';
      const shareCancelled = root.dataset.shareCancelled ?? '';
      const shareFailed = root.dataset.shareFailed ?? '';
      const clipboardTextTemplate = root.dataset.clipboardTextTemplate ?? '';

      const layout = buildSetlistCardLayout();

      // Preview: draws the same commands as the saved card onto the on-screen
      // canvas. renderCommands also builds a JPEG blob after drawing, so a
      // blob failure here is ignored — the drawing itself already landed.
      if (preview) {
        renderCommands(preview, layout, messages).catch(() => {});
      }

      const currentShareUrl = window.location.href;
      if (shareUrl) shareUrl.textContent = currentShareUrl;
      const copyFallback = () =>
        copyFallbackTemplate.replace('{url}', currentShareUrl);

      copyShare?.addEventListener('click', async () => {
        if (!navigator.clipboard?.writeText) {
          status.textContent = copyFallback();
          return;
        }
        try {
          await navigator.clipboard.writeText(
            clipboardTextTemplate.replace('{url}', currentShareUrl),
          );
          status.textContent = copiedStatus;
        } catch {
          status.textContent = copyFallback();
        }
      });

      button.addEventListener('click', async () => {
        if (isGenerating) return;
        try {
          isGenerating = true;
          button.disabled = true;
          error.hidden = true;
          status.textContent = generatingStatus;
          const blob = await renderCommands(
            document.createElement('canvas'),
            layout,
            messages,
          );
          downloadBlob(blob, 'weeknd-goyang-expected-setlist.jpg');
          status.textContent = savedStatus;
          const file = new File([blob], 'weeknd-goyang-expected-setlist.jpg', {
            type: 'image/jpeg',
          });
          if (navigator.share && navigator.canShare?.({ files: [file] })) {
            shareButton?.remove();
            shareButton = document.createElement('button');
            shareButton.type = 'button';
            shareButton.textContent = shareLabel;
            shareButton.addEventListener('click', async () => {
              try {
                await navigator.share({
                  files: [file],
                  title: shareTitle,
                  text: shareTitle,
                  url: currentShareUrl,
                });
                status.textContent = sharedStatus;
              } catch (shareError) {
                if (
                  shareError instanceof DOMException &&
                  shareError.name === 'AbortError'
                ) {
                  status.textContent = shareCancelled;
                } else {
                  error.textContent = shareFailed;
                  error.hidden = false;
                }
              }
            });
            button.insertAdjacentElement('afterend', shareButton);
          }
        } catch (caught) {
          error.textContent =
            caught instanceof Error ? caught.message : messages.exportFailed;
          error.hidden = false;
          status.textContent = '';
        } finally {
          isGenerating = false;
          button.disabled = false;
        }
      });
    });
</script>

<style>
  .share-builder {
    container-type: inline-size;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  header {
    display: grid;
    gap: 1rem;
    max-width: 74rem;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 10rem);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 0.8;
  }
  .lead {
    max-width: 40rem;
    margin: 0;
    color: var(--mist);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .share-builder__grid {
    display: grid;
    grid-template-columns: minmax(0, 32rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    max-width: 74rem;
    min-width: 0;
  }

  .share-builder__grid > * {
    min-width: 0;
  }

  @container (max-width: 56rem) {
    .share-builder__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card-preview {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }
  .card-preview canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1080 / 1638;
    border: 1px solid color-mix(in srgb, var(--amber) 35%, transparent);
    background: #080807;
    color: var(--mist);
  }
  .card-preview figcaption {
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .share-builder__controls {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .card-facts {
    display: grid;
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 30%, transparent);
  }
  .card-facts > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }
  .card-facts dt {
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .card-facts dd {
    margin: 0;
    color: var(--ivory);
    font-weight: 700;
  }
  .card-facts__caveat {
    color: var(--amber) !important;
    font-weight: 900 !important;
  }

  button {
    background: var(--amber);
    border: 1px solid var(--amber);
    border-radius: 0;
    color: var(--night);
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    min-height: 48px;
    padding: 0.55rem 0.8rem;
  }
  button:disabled {
    opacity: 0.5;
  }
  button:focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }
  .privacy-note,
  .status {
    margin: 0;
    color: var(--mist);
    font-size: 0.92rem;
  }
  .status {
    min-height: 1.5em;
  }
  .error {
    margin: 0;
    color: #ffbac0;
  }

  .share-fallback {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }
  .share-fallback__title {
    margin: 0;
    color: var(--ivory);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .share-fallback__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    align-items: center;
  }
  .share-fallback__actions a {
    color: var(--ivory);
    font-weight: 800;
  }
  .share-fallback button {
    background: transparent;
    border-color: color-mix(in srgb, var(--amber) 60%, transparent);
    color: var(--ivory);
    min-height: 44px;
  }
  .share-fallback code {
    overflow-wrap: anywhere;
    color: var(--mist);
    font-size: 0.85rem;
  }

  .share-builder__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--ivory);
    font-weight: 800;
    text-decoration: none;
  }
  .share-builder__back:hover,
  .share-builder__back:focus-visible {
    color: var(--amber);
  }

  @media (max-width: 48rem) {
    .share-builder,
    .share-builder__grid {
      grid-template-columns: minmax(0, 1fr);
      min-width: 0;
      width: 100%;
    }

    .card-preview {
      max-width: 100%;
      min-width: 0;
    }

    .share-builder__grid > *,
    form,
    .share-builder__controls {
      min-width: 0;
      width: 100%;
      max-width: 100%;
    }
  }
</style>
