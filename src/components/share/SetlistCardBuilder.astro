---
interface Props {
  version: string;
  songs: string[];
  shareUrl: string;
}
const { version, songs, shareUrl } = Astro.props;
const updated = version.replaceAll('-', '.');
---

<section
  class="share-builder"
  data-setlist-builder
  data-version={version}
  data-songs={JSON.stringify(songs)}
>
  <header>
    <p class="eyebrow">SHARE · 예상 셋리스트를 이미지로</p>
    <h1>SETLIST CARD</h1>
    <p class="lead">
      예상 셋리스트 {songs.length}곡을 세로형 이미지 한 장(1080×1350)으로
      만듭니다. 저장해서 스토리·단톡방에 올리거나, 공연 전 예습용으로 갤러리에
      넣어 두세요.
    </p>
  </header>

  <div class="share-builder__grid">
    <figure class="card-preview">
      <canvas
        data-preview
        width="1080"
        height="1350"
        role="img"
        aria-label="예상 셋리스트 카드 미리보기"
      >
        미리보기는 JavaScript가 켜져 있을 때 표시됩니다. 저장 버튼으로 만드는
        이미지와 같은 카드입니다.
      </canvas>
      <figcaption>미리보기 · 저장되는 이미지와 같습니다</figcaption>
    </figure>

    <div class="share-builder__controls">
      <dl class="card-facts">
        <div>
          <dt>담기는 곡</dt>
          <dd>{songs.length}곡</dd>
        </div>
        <div>
          <dt>기준</dt>
          <dd>최근 2026년 공연 기록 · UPDATED {updated}</dd>
        </div>
        <div>
          <dt>정확도</dt>
          <dd class="card-facts__caveat">예상 · 보장 아님</dd>
        </div>
      </dl>

      <button type="button" data-download-setlist>셋리스트 카드 저장</button>
      <p class="privacy-note">
        이미지는 이 브라우저 안에서만 생성되며 선택값을 저장하지 않습니다.
      </p>
      <p class="status" aria-live="polite" data-status></p>
      <p class="error" role="alert" hidden data-error></p>

      <div class="share-fallback">
        <p class="share-fallback__title">이미지 저장이 안 되면</p>
        <div class="share-fallback__actions">
          <a href="/og/default.jpg">기본 공유 이미지 보기</a>
          <button type="button" data-copy-share>텍스트 공유 문구 복사</button>
        </div>
        <code data-share-url>{shareUrl}</code>
      </div>

      <a class="share-builder__back" href="/setlist/"
        >곡별 관람 포인트 보기 <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
</section>

<script>
  import { buildSetlistCardLayout } from '../../lib/share/buildSetlistCardLayout';
  import { renderCommands } from '../../lib/share/canvas';
  import { downloadBlob } from '../../lib/share/download';

  document
    .querySelectorAll<HTMLElement>('[data-setlist-builder]')
    .forEach((root) => {
      const version = root.dataset.version ?? '';
      const songs = JSON.parse(root.dataset.songs ?? '[]') as string[];
      const button = root.querySelector<HTMLButtonElement>(
        '[data-download-setlist]',
      );
      const preview = root.querySelector<HTMLCanvasElement>('[data-preview]');
      const status = root.querySelector<HTMLElement>('[data-status]');
      const error = root.querySelector<HTMLElement>('[data-error]');
      const copyShare =
        root.querySelector<HTMLButtonElement>('[data-copy-share]');
      const shareUrl = root.querySelector<HTMLElement>('[data-share-url]');
      let isGenerating = false;
      let shareButton: HTMLButtonElement | undefined;
      if (!button || !status || !error) return;

      const layout = buildSetlistCardLayout({ version, songs });

      // 미리보기: 저장되는 카드와 같은 명령을 화면 캔버스에 그린다.
      // renderCommands 는 그린 뒤 JPEG blob 까지 만들므로 blob 실패는 무시한다(그림은 이미 남아 있다).
      if (preview) {
        renderCommands(preview, layout).catch(() => {});
      }

      const currentShareUrl = window.location.href;
      if (shareUrl) shareUrl.textContent = currentShareUrl;

      copyShare?.addEventListener('click', async () => {
        if (!navigator.clipboard?.writeText) {
          status.textContent = `공유 문구를 직접 복사해 주세요: ${currentShareUrl}`;
          return;
        }
        try {
          await navigator.clipboard.writeText(
            `The Weeknd 고양 예상 셋리스트 — ${currentShareUrl}`,
          );
          status.textContent = '텍스트 공유 문구를 복사했습니다.';
        } catch {
          status.textContent = `공유 문구를 직접 복사해 주세요: ${currentShareUrl}`;
        }
      });

      button.addEventListener('click', async () => {
        if (isGenerating) return;
        try {
          isGenerating = true;
          button.disabled = true;
          error.hidden = true;
          status.textContent = '이미지를 생성하고 있습니다…';
          const blob = await renderCommands(
            document.createElement('canvas'),
            layout,
          );
          downloadBlob(blob, 'weeknd-goyang-expected-setlist.jpg');
          status.textContent = 'JPEG 셋리스트 카드를 저장했습니다.';
          const file = new File([blob], 'weeknd-goyang-expected-setlist.jpg', {
            type: 'image/jpeg',
          });
          if (navigator.share && navigator.canShare?.({ files: [file] })) {
            shareButton?.remove();
            shareButton = document.createElement('button');
            shareButton.type = 'button';
            shareButton.textContent = '공유';
            shareButton.addEventListener('click', async () => {
              try {
                await navigator.share({
                  files: [file],
                  title: 'The Weeknd 고양 예상 셋리스트',
                  text: 'The Weeknd 고양 예상 셋리스트',
                  url: currentShareUrl,
                });
                status.textContent = '셋리스트 카드를 공유했습니다.';
              } catch (shareError) {
                if (
                  shareError instanceof DOMException &&
                  shareError.name === 'AbortError'
                ) {
                  status.textContent =
                    '공유를 취소했습니다. JPEG를 저장하거나 문구를 복사할 수 있습니다.';
                } else {
                  error.textContent =
                    '공유에 실패했습니다. JPEG를 저장하거나 문구를 복사해 주세요.';
                  error.hidden = false;
                }
              }
            });
            button.insertAdjacentElement('afterend', shareButton);
          }
        } catch (caught) {
          error.textContent =
            caught instanceof Error
              ? caught.message
              : '이미지 생성에 실패했습니다. 다시 시도해 주세요.';
          error.hidden = false;
          status.textContent = '';
        } finally {
          isGenerating = false;
          button.disabled = false;
        }
      });
    });
</script>

<style>
  .share-builder {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  header {
    display: grid;
    gap: 1rem;
    max-width: 58rem;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 10rem);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 0.8;
  }
  .lead {
    max-width: 40rem;
    margin: 0;
    color: var(--mist);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .share-builder__grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    max-width: 64rem;
  }

  .card-preview {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }
  .card-preview canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
    background: #050507;
    color: var(--mist);
  }
  .card-preview figcaption {
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .share-builder__controls {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .card-facts {
    display: grid;
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 30%, transparent);
  }
  .card-facts > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }
  .card-facts dt {
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .card-facts dd {
    margin: 0;
    color: var(--ivory);
    font-weight: 700;
  }
  .card-facts__caveat {
    color: var(--amber) !important;
    font-weight: 900 !important;
  }

  button {
    background: var(--amber);
    border: 1px solid var(--amber);
    border-radius: 0;
    color: var(--night);
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    min-height: 48px;
    padding: 0.55rem 0.8rem;
  }
  button:disabled {
    opacity: 0.5;
  }
  button:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }
  .privacy-note,
  .status {
    margin: 0;
    color: var(--mist);
    font-size: 0.92rem;
  }
  .status {
    min-height: 1.5em;
  }
  .error {
    margin: 0;
    color: #ffbac0;
  }

  .share-fallback {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }
  .share-fallback__title {
    margin: 0;
    color: var(--ivory);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .share-fallback__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    align-items: center;
  }
  .share-fallback__actions a {
    color: var(--ivory);
    font-weight: 800;
  }
  .share-fallback button {
    background: transparent;
    border-color: color-mix(in srgb, var(--amber) 60%, transparent);
    color: var(--ivory);
    min-height: 44px;
  }
  .share-fallback code {
    overflow-wrap: anywhere;
    color: var(--mist);
    font-size: 0.85rem;
  }

  .share-builder__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--ivory);
    font-weight: 800;
    text-decoration: none;
  }
  .share-builder__back:hover,
  .share-builder__back:focus-visible {
    color: var(--amber);
  }

  @media (max-width: 48rem) {
    .share-builder,
    .share-builder__grid {
      grid-template-columns: minmax(0, 1fr);
      min-width: 0;
      width: 100%;
    }

    .card-preview {
      max-width: 100%;
      min-width: 0;
    }

    .share-builder__grid > *,
    form,
    .share-builder__controls {
      min-width: 0;
      width: 100%;
      max-width: 100%;
    }
  }
</style>
