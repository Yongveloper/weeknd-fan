---
import '@fontsource/anton/latin.css';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { localeHref } from '../../lib/i18n/routes';
import { ARTIST } from '../../lib/i18n/proper-nouns';

interface Props {
  locale: Locale;
  showDates: [string, string];
  showStarts: [string, string];
  songs: string[];
  shareUrl: string;
}

const { locale, showDates, showStarts, songs, shareUrl } = Astro.props;
const strings = ui(locale).share;
const shareTitle = strings.ticket.shareTitle.replace('{artist}', ARTIST);
const clipboardText = strings.ticket.clipboardText.replace('{artist}', ARTIST);
---

<section
  class="share-builder"
  data-ticket-builder
  data-show-starts={JSON.stringify(showStarts)}
  data-songs={JSON.stringify(songs)}
  data-msg-image-load-failed={strings.errors.imageLoadFailed}
  data-msg-canvas-unavailable={strings.errors.canvasUnavailable}
  data-msg-export-failed={strings.errors.exportFailed}
  data-empty-song-label={strings.ticket.emptySong}
  data-preview-expand-label={strings.ticket.previewExpand}
  data-preview-collapse-label={strings.ticket.previewCollapse}
  data-copy-fallback-template={strings.common.copyFallback}
  data-copied-status={strings.common.copiedStatus}
  data-generating-status={strings.common.generatingStatus}
  data-validation-error={strings.ticket.validationError}
  data-saved-status={strings.ticket.savedStatus}
  data-share-label={strings.common.shareLabel}
  data-share-title={shareTitle}
  data-shared-status={strings.ticket.sharedStatus}
  data-share-cancelled={strings.common.shareCancelled}
  data-share-failed={strings.common.shareFailed}
  data-clipboard-text-template={clipboardText}
>
  <header>
    <h1>D-DAY TICKET</h1>
    <p>{strings.ticket.intro}</p>
  </header>

  <div class="share-builder__grid">
    <figure class="card-preview" data-ticket-preview>
      <canvas
        id="ticket-preview-canvas"
        data-preview
        width="2070"
        height="990"
        role="img"
        aria-label={strings.ticket.previewAriaLabel}
      >
        {strings.ticket.previewFallback}
      </canvas>
      <figcaption>
        <span>{strings.ticket.previewCaption}</span>
        <a href="/downloads/into-dawn-ticket-original.png" download
          >{strings.common.originalPngLabel}</a
        >
        <button
          type="button"
          class="card-preview__toggle"
          data-preview-toggle
          aria-expanded="false"
          aria-controls="ticket-preview-canvas"
          hidden>{strings.ticket.previewExpand}</button
        >
      </figcaption>
    </figure>

    <form novalidate>
      <fieldset>
        <legend>{strings.ticket.dateLegend}</legend>
        {
          showDates.map((date, index) => (
            <label class="choice">
              <input
                type="radio"
                name="show-date"
                value={date}
                checked={index === 0}
              />
              <span>{date.replaceAll('-', '.')}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="song-fields">
        {
          strings.ticket.songLabels.map((label, index) => (
            <label>
              <span>{label}</span>
              <select required aria-label={label} data-song-select={index}>
                <option value="">{strings.ticket.emptySong}</option>
                {songs.map((song) => (
                  <option value={song}>{song}</option>
                ))}
              </select>
            </label>
          ))
        }
      </div>

      <button type="button" data-download-ticket
        >{strings.ticket.downloadButton}</button
      >
      <p class="privacy-note">
        {strings.ticket.privacyNote}
      </p>
      <p class="status" aria-live="polite" data-status></p>
      <p class="error" role="alert" hidden data-error></p>
      <div class="share-fallback" data-share-fallback>
        <p class="share-fallback__title">{strings.common.fallbackHeading}</p>
        <div class="share-fallback__actions">
          <a href="/og/default.jpg">{strings.common.fallbackImageLink}</a>
          <button type="button" data-copy-share
            >{strings.common.fallbackCopyButton}</button
          >
        </div>
        <code data-share-url>{shareUrl}</code>
      </div>
      <a class="share-builder__back" href={localeHref(locale, '/')}
        >{strings.ticket.backLink} <span aria-hidden="true">→</span></a
      >
    </form>
  </div>
</section>

<script>
  import { getSelectedShowLabel } from '../../lib/countdown';
  import { buildTicketLayout } from '../../lib/share/buildTicketLayout';
  import { renderCommands } from '../../lib/share/canvas';
  import { downloadBlob } from '../../lib/share/download';

  document
    .querySelectorAll<HTMLElement>('[data-ticket-builder]')
    .forEach((root) => {
      const showStarts = JSON.parse(
        root.dataset.showStarts ?? '[]',
      ) as string[];
      const [dayOneStart, dayTwoStart] = showStarts;
      const selects = [
        ...root.querySelectorAll<HTMLSelectElement>('[data-song-select]'),
      ];
      const button = root.querySelector<HTMLButtonElement>(
        '[data-download-ticket]',
      );
      const preview = root.querySelector<HTMLCanvasElement>('[data-preview]');
      const previewFigure = root.querySelector<HTMLElement>(
        '[data-ticket-preview]',
      );
      const previewToggle = root.querySelector<HTMLButtonElement>(
        '[data-preview-toggle]',
      );
      const status = root.querySelector<HTMLElement>('[data-status]');
      const error = root.querySelector<HTMLElement>('[data-error]');
      const copyShare =
        root.querySelector<HTMLButtonElement>('[data-copy-share]');
      const shareUrl = root.querySelector<HTMLElement>('[data-share-url]');
      const fallback = root.querySelector<HTMLElement>('[data-share-fallback]');
      let isGenerating = false;
      let shareButton: HTMLButtonElement | undefined;

      // Localized copy comes in as data-* so this script never imports the
      // ui dictionary — two of them would land in the client JS budget.
      const messages = {
        imageLoadFailed: root.dataset.msgImageLoadFailed ?? '',
        canvasUnavailable: root.dataset.msgCanvasUnavailable ?? '',
        exportFailed: root.dataset.msgExportFailed ?? '',
      };
      const emptySongLabel = root.dataset.emptySongLabel ?? '';
      const previewExpandLabel = root.dataset.previewExpandLabel ?? '';
      const previewCollapseLabel = root.dataset.previewCollapseLabel ?? '';
      const copyFallbackTemplate = root.dataset.copyFallbackTemplate ?? '';
      const copiedStatus = root.dataset.copiedStatus ?? '';
      const generatingStatus = root.dataset.generatingStatus ?? '';
      const validationError = root.dataset.validationError ?? '';
      const savedStatus = root.dataset.savedStatus ?? '';
      const shareLabel = root.dataset.shareLabel ?? '';
      const shareTitle = root.dataset.shareTitle ?? '';
      const sharedStatus = root.dataset.sharedStatus ?? '';
      const shareCancelled = root.dataset.shareCancelled ?? '';
      const shareFailed = root.dataset.shareFailed ?? '';
      const clipboardTextTemplate = root.dataset.clipboardTextTemplate ?? '';

      if (!button || !status || !error || !dayOneStart || !dayTwoStart) return;

      // The fallback box is server-rendered visible for no-JS visitors. With
      // JS it stays out of the way until saving fails, has already happened,
      // or this browser cannot trigger downloads at all.
      if (fallback) fallback.hidden = true;
      const revealFallback = () => {
        if (fallback) fallback.hidden = false;
      };
      if (!('download' in HTMLAnchorElement.prototype)) revealFallback();

      if (previewToggle && previewFigure) {
        previewToggle.hidden = false;
        previewToggle.addEventListener('click', () => {
          const expanded =
            previewToggle.getAttribute('aria-expanded') !== 'true';
          previewToggle.setAttribute('aria-expanded', String(expanded));
          previewFigure.classList.toggle('card-preview--expanded', expanded);
          previewToggle.textContent = expanded
            ? previewCollapseLabel
            : previewExpandLabel;
          // Keep the control reachable when the enlarged preview collapses.
          previewToggle.focus();
          previewToggle.scrollIntoView({
            block: 'nearest',
            behavior: 'instant',
          });
        });
      }

      const selections = () =>
        selects.map((select) => select.value).filter(Boolean);
      const getLayout = () => {
        const showDate = root.querySelector<HTMLInputElement>(
          'input[name="show-date"]:checked',
        )?.value;
        const showStart = showDate === '2026-10-08' ? dayTwoStart : dayOneStart;

        return buildTicketLayout({
          showDate: showDate ?? '2026-10-07',
          dDayLabel: getSelectedShowLabel({ now: new Date(), showStart }),
          songs: selections(),
          emptySongLabel,
        });
      };
      const renderPreview = () => {
        if (preview)
          renderCommands(preview, getLayout(), messages).catch(() => {});
      };
      const refresh = () => {
        const selected = selections();
        selects.forEach((select) => {
          [...select.options].forEach((option) => {
            option.disabled = Boolean(
              option.value &&
              option.value !== select.value &&
              selected.includes(option.value),
            );
          });
        });
      };

      selects.forEach((select) =>
        select.addEventListener('change', () => {
          error.hidden = true;
          error.textContent = '';
          refresh();
          renderPreview();
        }),
      );
      root
        .querySelectorAll<HTMLInputElement>('input[name="show-date"]')
        .forEach((input) => input.addEventListener('change', renderPreview));
      refresh();
      renderPreview();

      const currentShareUrl = window.location.href;
      if (shareUrl) shareUrl.textContent = currentShareUrl;
      const copyFallback = () =>
        copyFallbackTemplate.replace('{url}', currentShareUrl);

      copyShare?.addEventListener('click', async () => {
        if (!navigator.clipboard?.writeText) {
          status.textContent = copyFallback();
          return;
        }
        try {
          await navigator.clipboard.writeText(
            clipboardTextTemplate.replace('{url}', currentShareUrl),
          );
          status.textContent = copiedStatus;
        } catch {
          status.textContent = copyFallback();
        }
      });

      button.addEventListener('click', async () => {
        if (isGenerating) return;
        const selected = selections();
        if (selected.length !== 3 || new Set(selected).size !== 3) {
          error.textContent = validationError;
          error.hidden = false;
          return;
        }

        try {
          isGenerating = true;
          button.disabled = true;
          error.hidden = true;
          error.textContent = '';
          status.textContent = generatingStatus;
          const canvas = document.createElement('canvas');
          const blob = await renderCommands(canvas, getLayout(), messages);
          downloadBlob(blob, 'weeknd-goyang-dday-ticket.jpg');
          status.textContent = savedStatus;
          revealFallback();
          const file = new File([blob], 'weeknd-goyang-dday-ticket.jpg', {
            type: 'image/jpeg',
          });
          if (navigator.share && navigator.canShare?.({ files: [file] })) {
            shareButton?.remove();
            shareButton = document.createElement('button');
            shareButton.type = 'button';
            shareButton.textContent = shareLabel;
            shareButton.addEventListener('click', async () => {
              try {
                await navigator.share({
                  files: [file],
                  title: shareTitle,
                  text: shareTitle,
                  url: currentShareUrl,
                });
                status.textContent = sharedStatus;
              } catch (shareError) {
                if (
                  shareError instanceof DOMException &&
                  shareError.name === 'AbortError'
                ) {
                  status.textContent = shareCancelled;
                } else {
                  error.textContent = shareFailed;
                  error.hidden = false;
                }
              }
            });
            button.insertAdjacentElement('afterend', shareButton);
          }
        } catch (caught) {
          error.textContent =
            caught instanceof Error ? caught.message : messages.exportFailed;
          error.hidden = false;
          status.textContent = '';
          revealFallback();
        } finally {
          isGenerating = false;
          button.disabled = false;
          refresh();
        }
      });
    });
</script>

<style>
  .share-builder {
    container-type: inline-size;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: 74rem;
    min-width: 0;
    padding-block: clamp(2.75rem, 5.25vw, 5.25rem);
  }
  .share-builder__grid {
    align-items: start;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 1fr);
    max-width: 74rem;
    min-width: 0;
  }
  header,
  form,
  fieldset,
  .song-fields {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .share-builder__grid > *,
  .song-fields > *,
  select {
    min-width: 0;
    max-width: 100%;
  }
  .card-preview {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }
  .card-preview canvas {
    aspect-ratio: 2070 / 990;
    background: #080807;
    border: 1px solid color-mix(in srgb, var(--amber) 35%, transparent);
    color: var(--mist);
    display: block;
    height: auto;
    width: 100%;
  }
  .card-preview figcaption {
    display: grid;
    gap: 0.75rem;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }
  .card-preview__toggle {
    display: none;
    justify-self: start;
    min-height: 44px;
    padding: 0.45rem 0.65rem;
    background: transparent;
    border-color: color-mix(in srgb, var(--amber) 55%, transparent);
    color: var(--amber);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .card-preview__toggle:hover {
    border-color: var(--amber);
    color: var(--ivory);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 10rem);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 0.8;
  }
  header > p:last-child,
  .privacy-note {
    margin: 0;
    color: var(--mist);
    max-width: 42rem;
  }
  fieldset {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1rem;
    border: 0;
    margin: 0;
    padding: 0;
  }
  legend,
  label > span {
    color: var(--amber);
    font-weight: 800;
  }
  .choice {
    align-items: center;
    border-block: 1px solid color-mix(in srgb, var(--ivory) 30%, transparent);
    color: var(--ivory);
    display: flex;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.75rem 0;
  }
  .choice:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 30%, transparent);
  }
  input {
    inline-size: 1.2rem;
    block-size: 1.2rem;
    flex-shrink: 0;
    accent-color: var(--amber);
  }
  select,
  button {
    min-height: 48px;
    border: 1px solid var(--ivory);
    border-radius: 0;
    font: inherit;
    padding: 0.55rem 0.8rem;
  }
  select {
    background: var(--night);
    color: var(--ivory);
    width: 100%;
  }
  button {
    background: var(--amber);
    color: var(--night);
    cursor: pointer;
    font-weight: 900;
  }
  button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  select:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }
  .status {
    color: var(--mist);
    margin: 0;
    min-height: 1.5em;
  }
  .error {
    color: #ffbac0;
    margin: 0;
  }
  .share-fallback {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
  }
  .share-fallback[hidden] {
    display: none;
  }
  .share-fallback__title {
    margin: 0;
    color: var(--ivory);
    font-size: 0.9rem;
    font-weight: 800;
  }
  .share-fallback__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    align-items: center;
  }
  .share-fallback__actions a {
    color: var(--ivory);
    font-weight: 800;
  }
  .share-fallback button {
    background: transparent;
    border-color: color-mix(in srgb, var(--amber) 60%, transparent);
    color: var(--ivory);
    min-height: 44px;
  }
  .share-fallback code {
    overflow-wrap: anywhere;
    color: var(--mist);
    font-size: 0.85rem;
  }
  .share-builder__back {
    align-items: center;
    color: var(--ivory);
    display: inline-flex;
    font-weight: 800;
    gap: 0.4rem;
    justify-self: start;
    min-height: 44px;
    text-decoration: none;
  }
  .share-builder__back:hover,
  .share-builder__back:focus-visible {
    color: var(--amber);
  }
  @container (max-width: 56rem) {
    .share-builder__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .card-preview {
      grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
      align-items: center;
      gap: 1.25rem;
    }
    .card-preview__toggle:not([hidden]) {
      display: inline-flex;
      align-items: center;
    }
    .card-preview--expanded {
      grid-template-columns: minmax(0, 1fr);
    }
    .card-preview--expanded canvas {
      max-width: 28rem;
    }
    .card-preview--expanded figcaption {
      justify-items: start;
    }
  }
  @container (max-width: 20rem) {
    fieldset {
      grid-template-columns: minmax(0, 1fr);
    }
    .card-preview {
      grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
      gap: 0.75rem;
    }
    .card-preview--expanded {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @container (max-width: 12rem) {
    /* At large text sizes, reserve a full row for the preview controls. */
    .card-preview {
      grid-template-columns: minmax(0, 1fr);
    }
    .card-preview:not(.card-preview--expanded) canvas {
      max-width: 9rem;
    }
  }
  @media (max-width: 48rem) {
    .share-builder,
    .share-builder__grid {
      grid-template-columns: minmax(0, 1fr);
      min-width: 0;
      width: 100%;
    }

    .card-preview {
      max-width: 100%;
      min-width: 0;
    }

    .share-builder__grid > *,
    form,
    fieldset,
    .song-fields,
    select {
      min-width: 0;
      width: 100%;
      max-width: 100%;
    }
  }
</style>
