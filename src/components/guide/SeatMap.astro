---
import { Picture } from 'astro:assets';
import seatMap from '../../assets/guide/seat-map-interpark.png';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { VENUE, bilingual } from '../../lib/i18n/proper-nouns';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale).guide.seatMap;
const newTab = ui(locale).content.externalLink.newTab;
const alt = strings.alt.replaceAll('{venue}', bilingual(VENUE, locale));
const NOL_PRODUCT = 'https://nol.yanolja.com/ticket/products/26006903';
---

<figure class="seat-map" data-enter>
  <a
    href={seatMap.src}
    target="_blank"
    rel="noreferrer"
    aria-label={`${strings.openOriginalAriaLabel} ${newTab}`}
  >
    <Picture
      src={seatMap}
      widths={[445]}
      sizes="(max-width: 34rem) 100vw, 445px"
      formats={['avif', 'webp']}
      quality={70}
      alt={alt}
    />
  </a>
  <figcaption>
    {strings.sourcePrefix}
    <a href={NOL_PRODUCT} target="_blank" rel="noreferrer"
      >{strings.sourceLinkLabel}<span class="sr-only">{newTab}</span></a
    >
    <span class="nowrap">{strings.confirmedOn}</span>. {strings.opensNewTabNote}
  </figcaption>
</figure>

<style>
  /* The parenthetical confirmation note would otherwise split at the hyphen on narrow screens */
  .nowrap {
    white-space: nowrap;
  }

  .seat-map {
    display: grid;
    gap: 0.6rem;
    max-width: 32rem;
    margin: 0;
  }
  .seat-map > a {
    display: block;
  }
  .seat-map :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
    background: #fff;
  }
  figcaption {
    color: var(--ink-muted);
    font-size: 0.82rem;
  }
  figcaption a {
    color: var(--ivory);
    font-weight: 700;
  }
</style>
