---
import 'leaflet/dist/leaflet.css';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { VENUE, bilingual } from '../../lib/i18n/proper-nouns';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale).guide.liveMap;
const venue = bilingual(VENUE, locale);
const ariaLabel = strings.ariaLabel.replace('{venue}', venue);
const note = strings.note.replace('{venue}', venue);
---

<div class="live-map" role="region" aria-label={ariaLabel}>
  <div class="live-map__canvas" data-venue-map inert aria-hidden="true"></div>
  <p class="live-map__status" role="status" data-map-status>
    {strings.statusFallback}
  </p>
</div>
<p class="live-map__note">
  {note}
</p>

<script src="../../scripts/venue-map.ts"></script>

<style>
  .live-map {
    position: relative;
    isolation: isolate;
    max-width: 56rem;
    min-height: 19rem;
    aspect-ratio: 16 / 10;
    border: 1px solid color-mix(in srgb, var(--ivory) 18%, transparent);
    background: var(--night);
  }
  .live-map__canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .live-map[data-map-state='ready'] .live-map__canvas {
    opacity: 1;
  }
  .live-map__status {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: 1.5rem;
    margin: 0;
    text-align: center;
    color: var(--ink-muted);
  }
  .live-map__status[hidden] {
    display: none;
  }
  .live-map :global(.venue-pin) {
    display: grid;
    place-items: center;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #573615;
    box-shadow: 0 2px 8px #0006;
  }
  .live-map :global(.venue-pin::after) {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f5cf92;
  }
  .live-map :global(.venue-label) {
    padding: 0.4rem 0.65rem;
    border: 0;
    color: #20170f;
    font: 700 13px/1.4 sans-serif;
  }
  .live-map :global(.leaflet-control-zoom a) {
    width: 44px;
    height: 44px;
    line-height: 44px;
    color: #20170f;
  }
  .live-map__note {
    margin: 0.5rem 0 0;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }
</style>
