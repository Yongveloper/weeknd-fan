---
// Coordinate check: https://en.wikipedia.org/wiki/Goyang_Stadium
// (37.6763528, 126.7432083), confirmed 2026-08-29.
// The difference from our 37.6755 / 126.7448 baseline is 0.0009° latitude,
// 0.0016° longitude — within the ±0.003° tolerance.
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { VENUE } from '../../lib/i18n/proper-nouns';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale).guide.directions;
const LAT = 37.6764;
const LNG = 126.7432;
// Domestic map apps resolve the korean name reliably; a translated name
// often does not, so the query param stays korean regardless of locale.
const NAME = VENUE.ko;
const links = [
  {
    label: strings.kakaoMapLabel,
    href: `https://map.kakao.com/link/to/${encodeURIComponent(NAME)},${LAT},${LNG}`,
  },
  {
    label: strings.naverMapLabel,
    href: `https://map.naver.com/p/search/${encodeURIComponent(NAME)}`,
  },
  {
    label: strings.googleMapLabel,
    href: `https://www.google.com/maps/dir/?api=1&destination=${LAT},${LNG}&travelmode=transit`,
  },
];
---

<nav class="directions" aria-label={strings.navAriaLabel} data-enter-group>
  {
    links.map((link) => (
      <a href={link.href} target="_blank" rel="noreferrer">
        {link.label} <span aria-hidden="true">↗</span>
      </a>
    ))
  }
</nav>

<style>
  /* Equal tracks, so the three buttons never stack at three different widths
     when the row is too narrow to hold two of them. */
  .directions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.7rem;
  }
  .directions a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 1px solid color-mix(in srgb, var(--amber) 60%, transparent);
    color: var(--ivory);
    font-weight: 800;
    text-decoration: none;
    transition: background var(--motion-fast) var(--ease-cinematic);
  }
  .directions a:hover,
  .directions a:focus-visible {
    background: color-mix(in srgb, var(--amber) 16%, transparent);
  }
</style>
