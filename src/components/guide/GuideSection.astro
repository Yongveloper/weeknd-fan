---
import { render } from 'astro:content';
import SourceList from '../content/SourceList.astro';
import StatusBadge from '../content/StatusBadge.astro';
import SourceLanguageNotice from '../content/SourceLanguageNotice.astro';
import type { Locale } from '../../lib/i18n/locales';
import { DEFAULT_LOCALE } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import type { SourceRecord } from '../../lib/content/contracts';
import { formatSeoulDate } from '../../lib/content/audit';
import {
  resolveSourceReferences,
  type LocalizedGuide,
} from '../../lib/content/queries';

interface Props {
  locale: Locale;
  entry: LocalizedGuide;
  sources: SourceRecord[];
}

const { locale, entry, sources } = Astro.props;
const strings = ui(locale).guide.section;
const { Content } = await render(entry.renderEntry);
const entrySources = resolveSourceReferences(
  entry.data.sources,
  sources,
  locale,
);
// The title, summary and body are korean source text until an overlay
// translates them; mark that explicitly so assistive tech doesn't speak
// korean prose in an english voice.
const contentLang = entry.translated ? locale : DEFAULT_LOCALE;
// Listed rather than Object.values(): the dictionary key-set test sorts its
// keys, so a reorder in en.ts would silently reorder the rendered list.
const pendingItems = [
  strings.pendingItems.entryGate,
  strings.pendingItems.prohibitedItems,
  strings.pendingItems.trafficControl,
  strings.pendingItems.shuttleOperations,
  strings.pendingItems.accessibilitySupport,
  strings.pendingItems.standingEarlyEntry,
];
---

<section
  id={entry.data.section}
  class="guide-section"
  aria-labelledby={`${entry.data.section}-title`}
  tabindex="-1"
  data-enter
>
  <div class="guide-section__heading">
    <p class="eyebrow">CONCERT GUIDE</p>
    <h2
      id={`${entry.data.section}-title`}
      data-guide-heading
      lang={contentLang}
    >
      {entry.data.title}
    </h2>
    <p lang={contentLang}>{entry.data.summary}</p>
  </div>

  {
    entry.data.section === 'pending' ? (
      <ul class="pending-list" aria-label={strings.pendingAriaLabel}>
        {pendingItems.map((item) => (
          <li>
            <strong>{item}</strong>
            <StatusBadge locale={locale} status="unpublished" />
            <span>
              {strings.lastCheckedPrefix}{' '}
              {formatSeoulDate(entry.data.lastVerifiedAt)}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="guide-section__meta">
        {!['official', 'practical'].includes(entry.data.status) && (
          <StatusBadge locale={locale} status={entry.data.status} />
        )}
        <span>
          {strings.lastCheckedPrefix}{' '}
          {formatSeoulDate(entry.data.lastVerifiedAt)}
        </span>
      </p>
    )
  }

  <slot name="lead" />
  {
    !entry.translated && locale !== DEFAULT_LOCALE && (
      <SourceLanguageNotice locale={locale} />
    )
  }
  <div class="guide-section__body" lang={contentLang}><Content /></div>
  <slot />
  <SourceList locale={locale} sources={entrySources} />
</section>

<style>
  .guide-section {
    display: grid;
    gap: 1.25rem;
    scroll-margin-top: calc(var(--guide-jump-clearance, 5.5rem) + 1px);
  }
  .guide-section__heading {
    display: grid;
    gap: 0.7rem;
    max-width: 55rem;
  }
  .guide-section__heading > p:last-child,
  .guide-section__body {
    color: var(--mist);
  }
  .guide-section__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: center;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .guide-section__body {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
  }
  .guide-section__body :global(p),
  .guide-section__body :global(ul) {
    margin: 0;
  }
  /* Guide body markdown opens each paragraph with a bold anchor phrase (e.g.
     "**Exit 3 of Daehwa Station**, then…"); color it like the section's h3
     so the eye can skip between them. */
  .guide-section__body :global(p > strong:first-child) {
    color: var(--amber);
  }
  .guide-section__body :global(ul) {
    display: grid;
    gap: 0.45rem;
    padding-left: 1.25rem;
  }
  .guide-section__body :global(h2),
  .guide-section__body :global(h3) {
    margin-top: 0.75rem;
    color: var(--amber);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.5;
  }
  .pending-list {
    display: grid;
    max-width: 52rem;
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
    list-style: none;
  }
  .pending-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    align-items: center;
    min-height: 44px;
    padding: 0.8rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
  }
  .pending-list strong {
    min-width: min(100%, 13rem);
  }
  .pending-list span:last-child {
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }
</style>
