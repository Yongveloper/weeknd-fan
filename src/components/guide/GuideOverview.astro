---
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { STATUS_LABELS, type TrustStatus } from '../../lib/content/contracts';

interface GuideItem {
  id: string;
  label: string;
  status: TrustStatus;
}

interface Props {
  locale: Locale;
  items: GuideItem[];
}

const { locale, items } = Astro.props;
const strings = ui(locale).guide.overview;
const groups = [
  { label: strings.beforeArrival, ids: ['transport', 'packing'] },
  { label: strings.entry, ids: ['official', 'pending'] },
  { label: strings.show, ids: ['seating', 'tips'] },
  { label: strings.goingHome, ids: ['return'] },
].map((group) => ({
  ...group,
  items: group.ids.flatMap((id) => items.filter((item) => item.id === id)),
  statusLabels: [
    ...new Set(
      items
        .filter(
          (item) =>
            group.ids.includes(item.id) &&
            !['official', 'practical'].includes(item.status),
        )
        .map((item) => STATUS_LABELS[item.status]),
    ),
  ],
}));
---

<nav class="guide-overview" aria-label={strings.summaryAriaLabel}>
  {
    groups.map((group) => (
      <a href={`#${group.ids[0]}`}>
        <strong>{group.label}</strong>
        <span>{group.items.map((item) => item.label).join(' · ')}</span>
        {group.statusLabels.length > 0 && (
          <small>{group.statusLabels.join(' · ')}</small>
        )}
      </a>
    ))
  }
</nav>

<style>
  .guide-overview {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  a {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-height: 44px;
    padding: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ivory) 24%, transparent);
    color: var(--ivory);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    border-color: var(--amber);
  }
  strong {
    color: var(--amber);
  }
  small {
    color: var(--ink-muted);
    font-size: 0.76rem;
    font-weight: 700;
  }
  @media (max-width: 44rem) {
    .guide-overview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
