---
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import {
  SHUTTLE_METRO_STOPS,
  SHUTTLE_REGIONAL_STOPS,
  STATION_KINTEX,
  VENUE,
  bilingual,
} from '../../lib/i18n/proper-nouns';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale).guide.transport;
const metroAreas = SHUTTLE_METRO_STOPS.map((stop) => bilingual(stop, locale));
const regionalAreas = SHUTTLE_REGIONAL_STOPS.map((stop) =>
  bilingual(stop, locale),
);
const shuttleRoute = strings.shuttleRoute
  .replace('{kintex}', bilingual(STATION_KINTEX, locale))
  .replace('{venue}', bilingual(VENUE, locale));
---

<section
  class="transport-operations"
  aria-labelledby="transport-operations-title"
>
  <div class="transport-operations__heading">
    <p>{strings.eyebrow}</p>
    <h3 id="transport-operations-title">{strings.heading}</h3>
  </div>

  <div class="transport-operations__parking">
    <strong>{strings.noParkingHeading}</strong>
    <p>
      {strings.noParkingBody}
    </p>
  </div>

  <div class="transport-operations__option">
    <h4>{strings.shuttleHeading}</h4>
    <p>
      <strong>{shuttleRoute}</strong>
    </p>
    <p class="transport-operations__pending">
      {strings.shuttlePending}
    </p>
  </div>

  <div class="transport-operations__option">
    <h4>{strings.kakaoHeading}</h4>
    <p>
      {strings.kakaoIntro}
      <a href="https://kko.to/NSrfta0uxT" target="_blank" rel="noreferrer"
        >{strings.kakaoReserveLabel} <span aria-hidden="true">↗</span></a
      >
    </p>
    <div class="transport-operations__areas">
      <div>
        <strong>{strings.metroAreasHeading}</strong>
        <ul aria-label={strings.metroAreasAriaLabel}>
          {metroAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>
      <div>
        <strong>{strings.regionalAreasHeading}</strong>
        <ul aria-label={strings.regionalAreasAriaLabel}>
          {regionalAreas.map((area) => <li>{area}</li>)}
        </ul>
      </div>
    </div>
    <p class="transport-operations__detail">
      {strings.kakaoDetail}
    </p>
  </div>
</section>

<style>
  .transport-operations {
    display: grid;
    gap: 1rem;
    max-width: 56rem;
  }
  .transport-operations__heading {
    display: grid;
    gap: 0.25rem;
  }
  .transport-operations__heading p,
  .transport-operations__pending {
    color: var(--amber);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  h3,
  h4,
  p {
    margin: 0;
  }
  h3,
  h4 {
    font-family: var(--font-body);
    letter-spacing: 0;
  }
  h3 {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
  }
  h4 {
    color: var(--ivory);
    font-size: 1rem;
  }
  .transport-operations__parking,
  .transport-operations__option {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--ivory) 22%, transparent);
  }
  .transport-operations__parking {
    border-color: color-mix(in srgb, var(--amber) 65%, transparent);
    background: color-mix(in srgb, var(--amber) 8%, transparent);
  }
  .transport-operations__parking > strong {
    color: var(--amber);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
  }
  .transport-operations__option p,
  .transport-operations__parking p,
  .transport-operations__detail {
    color: var(--mist);
  }
  a {
    color: var(--ivory);
    font-weight: 800;
    overflow-wrap: anywhere;
  }
  .transport-operations__areas {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .transport-operations__areas > div {
    min-width: 0;
  }
  /* Equal tracks keep the rows even. A wrapping flex row sized each chip to
     its label, which left the seventh region alone on a row of its own. */
  .transport-operations__areas ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4rem, 1fr));
    gap: 0.35rem;
    margin: 0.45rem 0 0;
    padding: 0;
    list-style: none;
  }
  .transport-operations__areas li {
    text-align: center;
    padding: 0.2rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--mist) 36%, transparent);
    border-radius: 999px;
    font-size: 0.8rem;
  }
  @media (max-width: 36rem) {
    .transport-operations__areas {
      grid-template-columns: 1fr;
    }
  }
</style>
