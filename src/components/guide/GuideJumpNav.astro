---
interface Props {
  items: Array<{ id: string; label: string }>;
}

const { items } = Astro.props;
---

<guide-jump-nav class="guide-jump">
  <nav aria-label="가이드 섹션">
    {items.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
  </nav>
</guide-jump-nav>

<script>
  class GuideJumpNav extends HTMLElement {
    private frame = 0;
    private observer?: IntersectionObserver;
    private resizeObserver?: ResizeObserver;
    private scrollHandler?: EventListener;
    private resizeHandler?: EventListener;
    private historyHandler?: EventListener;
    private loadHandler?: EventListener;
    private inputHandler?: EventListener;
    private initialHashTarget?: string;
    private hashSettleTimer?: number;

    private syncClearance = () => {
      const parent = this.parentElement;
      if (!parent) return;
      parent.style.setProperty(
        '--guide-jump-clearance',
        `${this.getBoundingClientRect().height}px`,
      );
    };

    connectedCallback() {
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a'));
      const sections = links.flatMap((link) => {
        const target = document.getElementById(link.hash.slice(1));
        return target ? [{ link, target }] : [];
      });
      if (sections.length === 0) return;

      const setCurrent = (id: string) => {
        let current: HTMLAnchorElement | undefined;
        links.forEach((link) => {
          if (link.hash === `#${id}`) {
            link.setAttribute('aria-current', 'location');
            current = link;
          } else link.removeAttribute('aria-current');
        });
        const nav = current?.parentElement;
        if (!current || !nav) return;
        const left = current.offsetLeft;
        const right = left + current.offsetWidth;
        const viewportLeft = nav.scrollLeft;
        const viewportRight = viewportLeft + nav.clientWidth;
        if (left >= viewportLeft && right <= viewportRight) return;
        nav.scrollTo({
          left: left < viewportLeft ? left : right - nav.clientWidth,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
            .matches
            ? 'auto'
            : 'smooth',
        });
      };
      const alignHashTarget = (id: string) => {
        sections
          .find((section) => section.target.id === id)
          ?.target.scrollIntoView({
            behavior: 'instant' as ScrollBehavior,
            block: 'start',
          });
        setCurrent(id);
      };
      const finishHashTarget = () => {
        const id = this.initialHashTarget;
        this.initialHashTarget = undefined;
        this.hashSettleTimer = undefined;
        if (id) alignHashTarget(id);
      };
      const queueHashTarget = (id: string) => {
        this.initialHashTarget = id;
        if (this.hashSettleTimer) window.clearTimeout(this.hashSettleTimer);
        this.hashSettleTimer = window.setTimeout(finishHashTarget, 1000);
      };
      const update = () => {
        this.frame = 0;
        if (this.initialHashTarget) {
          alignHashTarget(this.initialHashTarget);
          return;
        }
        const stickyBottom = this.getBoundingClientRect().bottom;
        const crossing = sections.filter(
          (section) =>
            section.target.getBoundingClientRect().top <= stickyBottom + 1,
        );
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 1;
        setCurrent(
          (atBottom ? sections.at(-1) : (crossing.at(-1) ?? sections[0]))!
            .target.id,
        );
      };
      const schedule = () => {
        if (this.frame === 0) this.frame = requestAnimationFrame(update);
      };

      const hashUpdate = () => {
        const hashId = window.location.hash.slice(1);
        if (sections.some((section) => section.target.id === hashId))
          queueHashTarget(hashId);
        schedule();
      };
      this.scrollHandler = () => {
        schedule();
      };
      this.resizeHandler = schedule;
      this.historyHandler = hashUpdate;
      this.loadHandler = schedule;
      this.inputHandler = (event) => {
        if (!event.isTrusted || !this.initialHashTarget) return;
        this.initialHashTarget = undefined;
        if (this.hashSettleTimer) {
          window.clearTimeout(this.hashSettleTimer);
          this.hashSettleTimer = undefined;
        }
      };
      this.observer = new IntersectionObserver(schedule, { threshold: [0, 1] });
      sections.forEach(({ target }) => this.observer?.observe(target));
      this.resizeObserver = new ResizeObserver(() => {
        this.syncClearance();
        schedule();
      });
      this.resizeObserver.observe(this);
      this.syncClearance();
      window.addEventListener('scroll', this.scrollHandler, { passive: true });
      window.addEventListener('resize', this.resizeHandler);
      window.addEventListener('hashchange', this.historyHandler);
      window.addEventListener('popstate', this.historyHandler);
      window.addEventListener('load', this.loadHandler);
      for (const event of ['wheel', 'touchstart', 'pointerdown', 'keydown'])
        window.addEventListener(event, this.inputHandler, { passive: true });
      const initialHashId = window.location.hash.slice(1);
      if (sections.some((section) => section.target.id === initialHashId))
        queueHashTarget(initialHashId);
      schedule();
    }

    disconnectedCallback() {
      if (this.frame) cancelAnimationFrame(this.frame);
      if (this.hashSettleTimer) window.clearTimeout(this.hashSettleTimer);
      this.observer?.disconnect();
      this.resizeObserver?.disconnect();
      if (this.scrollHandler)
        window.removeEventListener('scroll', this.scrollHandler);
      if (this.resizeHandler)
        window.removeEventListener('resize', this.resizeHandler);
      if (this.historyHandler) {
        window.removeEventListener('hashchange', this.historyHandler);
        window.removeEventListener('popstate', this.historyHandler);
      }
      if (this.loadHandler)
        window.removeEventListener('load', this.loadHandler);
      if (this.inputHandler)
        for (const event of ['wheel', 'touchstart', 'pointerdown', 'keydown'])
          window.removeEventListener(event, this.inputHandler);
      this.parentElement?.style.removeProperty('--guide-jump-clearance');
    }
  }

  if (!customElements.get('guide-jump-nav'))
    customElements.define('guide-jump-nav', GuideJumpNav);
</script>

<style>
  :global(guide-jump-nav.guide-jump) {
    display: flex;
  }
  :global(.guide-jump a[aria-current='location']) {
    border-color: var(--amber);
    color: var(--ivory);
  }
</style>
