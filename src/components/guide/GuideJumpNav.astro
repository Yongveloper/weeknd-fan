---
interface Props {
  items: Array<{ id: string; label: string }>;
}

const { items } = Astro.props;
---

<guide-jump-nav class="guide-jump">
  <nav aria-label="가이드 섹션">
    {items.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
  </nav>
</guide-jump-nav>

<script>
  class GuideJumpNav extends HTMLElement {
    private frame = 0;
    private observer?: IntersectionObserver;
    private resizeObserver?: ResizeObserver;
    private scrollHandler?: EventListener;
    private resizeHandler?: EventListener;
    private historyHandler?: EventListener;
    private initialHashTarget?: string;

    connectedCallback() {
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a'));
      const sections = links.flatMap((link) => {
        const target = document.getElementById(link.hash.slice(1));
        const heading = target?.querySelector<HTMLElement>(
          '[data-guide-heading], h2',
        );
        return target && heading ? [{ link, target, heading }] : [];
      });
      if (sections.length === 0) return;

      const setCurrent = (id: string) => {
        links.forEach((link) => {
          if (link.hash === `#${id}`)
            link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      const update = () => {
        this.frame = 0;
        if (this.initialHashTarget) {
          setCurrent(this.initialHashTarget);
          this.initialHashTarget = undefined;
          return;
        }
        const stickyBottom = this.getBoundingClientRect().bottom;
        const crossing = sections.filter(
          (section) =>
            section.heading.getBoundingClientRect().top <= stickyBottom + 1,
        );
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 1;
        setCurrent(
          (atBottom ? sections.at(-1) : (crossing.at(-1) ?? sections[0]))!
            .target.id,
        );
      };
      const schedule = () => {
        if (this.frame === 0) this.frame = requestAnimationFrame(update);
      };

      const hashUpdate = () => {
        schedule();
      };
      this.scrollHandler = () => {
        schedule();
      };
      this.resizeHandler = schedule;
      this.historyHandler = hashUpdate;
      this.observer = new IntersectionObserver(schedule, { threshold: [0, 1] });
      sections.forEach(({ heading }) => this.observer?.observe(heading));
      this.resizeObserver = new ResizeObserver(schedule);
      this.resizeObserver.observe(this);
      window.addEventListener('scroll', this.scrollHandler, { passive: true });
      window.addEventListener('resize', this.resizeHandler);
      window.addEventListener('hashchange', this.historyHandler);
      window.addEventListener('popstate', this.historyHandler);
      const initialHashId = window.location.hash.slice(1);
      if (sections.some((section) => section.target.id === initialHashId))
        this.initialHashTarget = initialHashId;
      schedule();
    }

    disconnectedCallback() {
      if (this.frame) cancelAnimationFrame(this.frame);
      this.observer?.disconnect();
      this.resizeObserver?.disconnect();
      if (this.scrollHandler)
        window.removeEventListener('scroll', this.scrollHandler);
      if (this.resizeHandler)
        window.removeEventListener('resize', this.resizeHandler);
      if (this.historyHandler) {
        window.removeEventListener('hashchange', this.historyHandler);
        window.removeEventListener('popstate', this.historyHandler);
      }
    }
  }

  if (!customElements.get('guide-jump-nav'))
    customElements.define('guide-jump-nav', GuideJumpNav);
</script>

<style>
  :global(guide-jump-nav.guide-jump) {
    display: flex;
  }
  :global(.guide-jump a[aria-current='location']) {
    border-color: var(--amber);
    color: var(--ivory);
  }
</style>
