---
import Disclosure from '../ui/Disclosure.astro';
import type { SetlistRecord } from '../../lib/content/contracts';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';

interface Props {
  entries: SetlistRecord[];
  previewCount: number;
  observationCount: number;
  locale: Locale;
}

const { entries, previewCount, observationCount, locale } = Astro.props;
const previewEntries = entries.slice(0, previewCount);
const remainingEntries = entries.slice(previewCount);
const strings = ui(locale).home.setlistPreview;
const comparisonTemplate =
  observationCount === 1 ? strings.comparison.one : strings.comparison.other;
const comparisonLabel = comparisonTemplate.replace(
  '{count}',
  String(observationCount),
);
---

<section
  id="setlist"
  class="setlist-preview fold fold--reverse"
  data-motion-scene-enter
  aria-labelledby="setlist-preview-title"
>
  <div class="shell-content setlist-preview__inner">
    <div class="setlist-preview__heading">
      <div class="setlist-preview__title-row">
        <h2 id="setlist-preview-title">{strings.heading}</h2>
      </div>
    </div>
    <p class="setlist-preview__comparison">
      {comparisonLabel}
    </p>
    {
      previewEntries.length > 0 ? (
        <ol class="setlist-preview__list setlist-preview__list--preview">
          {previewEntries.map((entry, index) => (
            <li style={`--i: ${index}`}>{entry.data.songTitle}</li>
          ))}
        </ol>
      ) : (
        <p class="setlist-preview__empty">{strings.empty}</p>
      )
    }
    <Disclosure
      ariaLabel={strings.fullListAriaLabel}
      label={strings.fullListLabel}
      class="setlist-preview__more"
      locale={locale}
    >
      {
        remainingEntries.length > 0 ? (
          <ol class="setlist-preview__list" start={previewEntries.length + 1}>
            {remainingEntries.map((entry) => (
              <li>{entry.data.songTitle}</li>
            ))}
          </ol>
        ) : (
          <p>{strings.fullListEmpty}</p>
        )
      }
    </Disclosure>
    <a class="setlist-preview__link" href="/setlist/"
      >{strings.pointsLink} <span aria-hidden="true">→</span></a
    >
    <a class="setlist-preview__link" href="/share/setlist/"
      >{strings.posterLink} <span aria-hidden="true">→</span></a
    >
  </div>
</section>

<style>
  .setlist-preview {
    padding-block: var(--section-space);
    overflow: hidden;
  }

  .setlist-preview::after {
    position: absolute;
    inset: 46% -30% auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--blue), transparent);
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  .setlist-preview__inner {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    column-gap: clamp(3rem, 7vw, 7rem);
  }

  .setlist-preview__inner > :global(*) {
    grid-column: 2;
  }
  .setlist-preview__inner > .setlist-preview__heading {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  @media (max-width: 48rem) {
    .setlist-preview__inner {
      grid-template-columns: 1fr;
    }
    .setlist-preview__inner > :global(*) {
      grid-column: 1;
    }
    .setlist-preview__inner > .setlist-preview__heading {
      grid-row: auto;
    }
  }

  .setlist-preview__heading {
    display: grid;
    gap: 0.5rem;
  }

  .setlist-preview__title-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    align-items: baseline;
  }

  .setlist-preview__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 2rem;
    max-width: 52rem;
    margin: 0;
    padding-left: 1.75rem;
    color: var(--ivory);
    font-size: calc(var(--type-scale) * clamp(1rem, 2vw, 1.2rem));
    font-weight: 700;
    perspective: 900px;
  }

  :global(html[data-motion-ready])
    .setlist-preview:not([data-motion-state='entered'])
    .setlist-preview__list--preview
    li {
    opacity: 0;
    transform: translateY(14px) rotateX(6deg);
  }

  :global(html[data-motion-ready])
    .setlist-preview[data-motion-state='entered']::after {
    animation: runway-sweep 560ms var(--ease-cinematic) both;
  }

  :global(html[data-motion-ready])
    .setlist-preview[data-motion-state='entered']
    .setlist-preview__list--preview
    li {
    animation: runway-rise 480ms var(--ease-cinematic) both;
    animation-delay: calc(var(--i, 0) * 30ms);
  }

  @keyframes runway-sweep {
    0% {
      opacity: 0;
      transform: translateX(-40%);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(40%);
    }
  }

  @keyframes runway-rise {
    from {
      opacity: 0;
      transform: translateY(14px) rotateX(6deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .setlist-preview__comparison {
    margin: 0;
    color: var(--mist);
    font-weight: 800;
  }

  .setlist-preview__list li::marker {
    color: var(--amber);
    font-family: var(--font-display);
  }

  .setlist-preview__empty,
  .setlist-preview__inner :global(.setlist-preview__more) p {
    max-width: 42rem;
    color: var(--mist);
  }

  .setlist-preview__inner :global(.setlist-preview__more) {
    max-width: 52rem;
  }

  .setlist-preview__link {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
    color: var(--ivory);
    font-weight: 800;
  }

  .setlist-preview__inner
    :global(.setlist-preview__more)
    .setlist-preview__list,
  .setlist-preview__inner :global(.setlist-preview__more) p {
    margin-block: 0.75rem 1.25rem;
  }

  @media (max-width: 36rem) {
    .setlist-preview__list {
      grid-template-columns: 1fr;
    }
  }
</style>
