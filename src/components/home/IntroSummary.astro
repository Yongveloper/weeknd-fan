---
import AlbumCover from '../content/AlbumCover.astro';
import type { AlbumRecord } from '../../lib/content/contracts';
import { findAlbumByTitle } from '../../lib/content/albums';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { localeHref } from '../../lib/i18n/routes';
import { ARTIST } from '../../lib/i18n/proper-nouns';

interface Props {
  albums: AlbumRecord[];
  locale: Locale;
}

const { albums, locale } = Astro.props;
const trilogy = ['After Hours', 'Dawn FM', 'Hurry Up Tomorrow']
  .map((title) => findAlbumByTitle(albums, title))
  .filter((album): album is AlbumRecord => Boolean(album));
const strings = ui(locale).home.intro;
// The heading wraps the artist name in its own font; split around the slot
// instead of assembling the sentence from translated fragments.
const [headingBefore = '', headingAfter = ''] =
  strings.heading.split('{artist}');
---

<section
  id="intro"
  class="home-entry home-entry--intro fold"
  data-enter
  aria-labelledby="intro-title"
>
  <div class="shell-content home-entry__inner">
    <h2 id="intro-title">
      {headingBefore}<span class="latin">{ARTIST}</span>{headingAfter}
    </h2>
    <p class="home-entry__description">
      {strings.description}
    </p>
    <ul class="home-entry__albums" aria-label={strings.albumsAriaLabel}>
      {
        trilogy.map((album) => (
          <li>
            <AlbumCover locale={locale} album={album} size={120} />
            <span class="home-entry__year">{album.data.year}</span>
            <span class="home-entry__album-title">{album.data.title}</span>
          </li>
        ))
      }
    </ul>
    <a href={localeHref(locale, '/discover/#timeline-title')}
      >{strings.cta} <span aria-hidden="true">→</span></a
    >
  </div>
</section>

<style>
  .home-entry {
    padding-block: var(--section-space);
  }

  .home-entry__inner {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .home-entry__albums {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 3vw, 1.25rem);
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: center;
    width: 100%;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .home-entry__albums li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    justify-items: center;
    text-align: center;
    min-width: 0;
    color: var(--mist);
    font-size: calc(var(--type-scale) * 0.8rem);
    font-weight: 800;
  }

  .home-entry__albums :global(.album-cover) {
    width: 80%;
    height: auto;
    aspect-ratio: 1;
  }

  .home-entry__description {
    color: var(--mist);
    font-size: calc(var(--type-scale) * clamp(1rem, 2vw, 1.15rem));
  }

  h2,
  .home-entry__description,
  a {
    grid-column: 1;
  }
  @media (max-width: 48rem) {
    .home-entry__inner {
      grid-template-columns: 1fr;
    }
    .home-entry__albums {
      grid-column: 1;
      grid-row: auto;
      max-width: 28rem;
    }
  }

  a {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
    color: var(--ivory);
    font-weight: 800;
  }
</style>
