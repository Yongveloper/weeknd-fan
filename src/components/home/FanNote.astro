---
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { localeHref } from '../../lib/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale).home.fanNote;
---

<section
  class="fan-note fold fold--reverse"
  data-enter
  aria-labelledby="fan-note-title"
>
  <div class="shell-content fan-note__inner">
    <h2 id="fan-note-title">{strings.heading}</h2>
    <p>{strings.body}</p>
    <a class="fan-note__cta" href={localeHref(locale, '/share/ticket/')}
      >{strings.cta} <span aria-hidden="true">→</span></a
    >
    <p class="fan-note__caption">FROM ONE FAN TO ANOTHER</p>
  </div>
</section>

<style>
  .fan-note {
    padding-block: var(--section-space);
  }

  .fan-note__inner {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    column-gap: clamp(3rem, 7vw, 7rem);
  }

  .fan-note__inner > * {
    grid-column: 2;
  }
  .fan-note__inner > h2 {
    grid-column: 1;
    grid-row: 1 / span 3;
  }
  @media (max-width: 48rem) {
    .fan-note__inner {
      grid-template-columns: 1fr;
    }
    .fan-note__inner > * {
      grid-column: 1;
    }
    .fan-note__inner > h2 {
      grid-row: auto;
    }
  }

  p:not(.fan-note__caption) {
    color: var(--ivory);
    font-size: calc(var(--type-scale) * clamp(1.1rem, 2.5vw, 1.4rem));
    font-weight: 700;
    line-height: 1.7;
  }

  .fan-note__cta {
    color: var(--ivory);
    font-weight: 900;
  }

  .fan-note__caption {
    color: var(--amber);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
</style>
