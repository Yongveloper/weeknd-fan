---
import type { ConcertRecord } from '../../lib/content/contracts';
import EclipseCountdown from '../visual/EclipseCountdown.astro';

interface Props {
  concert: ConcertRecord;
}

const { concert } = Astro.props;
const [dayOne, dayTwo] = concert.data.shows;

if (!dayOne || !dayTwo) {
  throw new Error('The Goyang countdown requires two show start times.');
}
---

<section class="home-hero" data-home-hero aria-labelledby="home-title">
  <div class="home-hero__visual" aria-hidden="true">
    <picture>
      <source
        srcset="/visual/moon-320.avif 320w, /visual/moon-560.avif 560w, /visual/moon-720.avif 720w, /visual/moon-960.avif 960w, /visual/moon-1254.avif 1254w"
        sizes="(max-width: 42rem) 84vw, 49vw"
        type="image/avif"
      />
      <source
        srcset="/visual/moon-320.webp 320w, /visual/moon-560.webp 560w, /visual/moon-720.webp 720w, /visual/moon-960.webp 960w, /visual/moon-1254.webp 1254w"
        sizes="(max-width: 42rem) 84vw, 49vw"
        type="image/webp"
      />
      <img
        class="home-hero__moon-art"
        data-moon-art
        src="/visual/moon-1254.webp"
        width="1254"
        height="1254"
        alt=""
      />
    </picture>
    <picture>
      <source
        srcset="/visual/fog-night-480.avif 480w, /visual/fog-night-768.avif 768w, /visual/fog-night-1024.avif 1024w, /visual/fog-night-1280.avif 1280w, /visual/fog-night-1536.avif 1536w"
        sizes="(max-width: 42rem) 150vw, 100vw"
        type="image/avif"
      />
      <source
        srcset="/visual/fog-night-480.webp 480w, /visual/fog-night-768.webp 768w, /visual/fog-night-1024.webp 1024w, /visual/fog-night-1280.webp 1280w, /visual/fog-night-1536.webp 1536w"
        sizes="(max-width: 42rem) 150vw, 100vw"
        type="image/webp"
      />
      <img
        class="home-hero__fog home-hero__fog--night"
        src="/visual/fog-night-1536.webp"
        width="1536"
        height="1024"
        alt=""
      />
    </picture>
    <picture>
      <source
        srcset="/visual/fog-dawn-480.avif 480w, /visual/fog-dawn-768.avif 768w, /visual/fog-dawn-1024.avif 1024w, /visual/fog-dawn-1280.avif 1280w, /visual/fog-dawn-1536.avif 1536w"
        sizes="(max-width: 42rem) 150vw, 100vw"
        type="image/avif"
      />
      <source
        srcset="/visual/fog-dawn-480.webp 480w, /visual/fog-dawn-768.webp 768w, /visual/fog-dawn-1024.webp 1024w, /visual/fog-dawn-1280.webp 1280w, /visual/fog-dawn-1536.webp 1536w"
        sizes="(max-width: 42rem) 150vw, 100vw"
        type="image/webp"
      />
      <img
        class="home-hero__fog home-hero__fog--dawn"
        data-hero-fog
        src="/visual/fog-dawn-1536.webp"
        width="1536"
        height="1024"
        alt=""
      />
    </picture>
  </div>
  <EclipseCountdown
    dayOneStart={dayOne.startsAt}
    dayTwoStart={dayTwo.startsAt}
    archivePublished={concert.data.archivePublished}
  />
  <div class="home-hero__content shell-content">
    <div class="home-hero__heading">
      <p class="eyebrow">AFTER HOURS TIL DAWN / GOYANG</p>
      <h1 id="home-title" class="display-latin">
        <span>AFTER HOURS</span>
        <span class="home-hero__dawn">TIL DAWN</span>
      </h1>
      <p>2026.10.07—08 · {concert.data.venue}</p>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: min(76vh, 58rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--night);
  }

  .home-hero__visual,
  .home-hero__visual :global(img) {
    position: absolute;
    inset: 0;
  }

  .home-hero__visual {
    z-index: -1;
  }

  .home-hero__moon-art {
    width: min(49vw, 39rem);
    height: auto;
    inset: auto clamp(-8rem, 2vw, 4rem) clamp(4rem, 8vh, 9rem) auto !important;
    border-radius: 50%;
    mix-blend-mode: screen;
    transform: translate3d(18vw, 18vh, 0) scale(0.86);
  }

  .home-hero__fog {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: screen;
    opacity: 0.68;
  }

  .home-hero__fog--dawn {
    opacity: 0;
  }

  .home-hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 8rem);
    padding-block: var(--section-space);
  }

  .home-hero__heading {
    align-self: center;
  }

  .home-hero :global(eclipse-countdown) {
    --eclipse-size: min(49vw, 39rem);
    position: absolute;
    z-index: 0;
    right: clamp(-8rem, 2vw, 4rem);
    bottom: clamp(4rem, 8vh, 9rem);
  }

  h1 {
    margin-top: 0.8rem;
    font-size: clamp(3.8rem, 16.5vw, 15rem);
    letter-spacing: 0.01em;
    line-height: 0.82;
    text-wrap: initial;
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  .home-hero__dawn {
    background: linear-gradient(
      90deg,
      var(--red),
      var(--blue) 64%,
      var(--amber)
    );
    background-clip: text;
    color: transparent;
  }

  h1 + p {
    max-width: 34rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    color: var(--mist);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
  }

  @media (max-width: 42rem) {
    .home-hero {
      min-height: 42rem;
    }

    .home-hero__content {
      grid-template-columns: 1fr;
      align-content: space-between;
    }

    .home-hero__moon-art {
      width: 84vw;
      inset: auto -10vw -4rem auto !important;
    }

    .home-hero :global(eclipse-countdown) {
      --eclipse-size: 84vw;
      right: -10vw;
      bottom: 1.25rem;
    }
  }
</style>
