---
import type { ConcertRecord } from '../../lib/content/contracts';
import EclipseCountdown from '../visual/EclipseCountdown.astro';

interface Props {
  concert: ConcertRecord;
  officialNoticeUrl: string;
}

const { concert, officialNoticeUrl } = Astro.props;
const [dayOne, dayTwo] = concert.data.shows;

if (!dayOne || !dayTwo) {
  throw new Error('The Goyang countdown requires two show start times.');
}
---

<section
  class="home-hero"
  data-home-hero
  data-motion-scene-enter
  aria-labelledby="home-title"
>
  <div class="home-hero__visual" aria-hidden="true">
    <picture>
      <source
        srcset="/visual/eclipse-400.avif 400w, /visual/eclipse-700.avif 700w, /visual/eclipse-1000.avif 1000w, /visual/eclipse-1400.avif 1400w, /visual/eclipse-2000.avif 2000w"
        sizes="103vw"
        type="image/avif"
      />
      <source
        srcset="/visual/eclipse-700.webp 700w, /visual/eclipse-1400.webp 1400w"
        sizes="103vw"
        type="image/webp"
      />
      <img
        class="home-hero__moon-art"
        data-moon-art
        src="/visual/eclipse-1400.webp"
        width="2000"
        height="2000"
        alt=""
      />
    </picture>
  </div>
  <EclipseCountdown
    dayOneStart={dayOne.startsAt}
    dayTwoStart={dayTwo.startsAt}
    archivePublished={concert.data.archivePublished}
  />
  <div class="home-hero__content shell-content">
    <div class="home-hero__heading">
      <p class="eyebrow">THE WEEKND · 비공식 팬 팜플렛</p>
      <h1 id="home-title" class="display-latin">
        <span>AFTER HOURS</span>
        <span class="home-hero__dawn">TIL DAWN</span>
      </h1>
      <p class="home-hero__facts">
        <span>2026.10.07—08</span>
        <span aria-hidden="true">·</span>
        <span>{concert.data.venue}</span>
        <span aria-hidden="true">·</span>
        <span>{concert.data.ageRestriction}</span>
        <a href={officialNoticeUrl} rel="noreferrer">공식 공지 ↗</a>
      </p>
    </div>
  </div>
</section>

<style>
  .home-hero {
    /* 일식 프레임은 h1 크기에 비례: 디스크(프레임의 56.6%) ≈ "AFTER HOURS" 폭 × 0.85.
       이미지와 카운트다운이 같은 변수로 배치되어 중심이 일치한다. */
    --hero-h1: clamp(3.8rem, 16.5vw, 15rem);
    /* 디스크 지름 = 2.807em(6.2em×0.566에서 20% 축소한 값, 유지). 프레임은 디스크의
       1/0.45 — 코로나 광선(≈2.2R)을 담기 위해 여유를 둔다. 중심: x = 텍스트 시작 + 4.2em,
       y = 히어로 44% */
    --hero-frame: calc(6.24 * var(--hero-h1));
    --hero-disc-cx: calc(
      max(var(--gutter), (100% - var(--content-max)) / 2) + 4.2 * var(--hero-h1)
    );
    --hero-frame-top: calc(44% - var(--hero-frame) / 2);
    --hero-frame-right: calc(
      100% - var(--hero-disc-cx) - var(--hero-frame) / 2
    );
    position: relative;
    display: grid;
    min-height: min(76vh, 58rem);
    overflow: hidden;
    isolation: isolate;
    background: transparent;
  }

  .home-hero__visual,
  .home-hero__visual :global(img) {
    position: absolute;
    inset: 0;
  }

  .home-hero__visual {
    z-index: -1;
  }

  .home-hero__moon-art {
    z-index: 1;
    width: var(--hero-frame);
    height: auto;
    inset: var(--hero-frame-top) var(--hero-frame-right) auto auto !important;
    transform: translate3d(18vw, 18vh, 0) scale(0.86);
  }

  .home-hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 8rem);
    padding-block: var(--section-space);
  }

  .home-hero__heading {
    position: relative;
    align-self: center;
    overflow: hidden;
  }

  .home-hero__heading::after {
    position: absolute;
    inset: -20% -60%;
    background: linear-gradient(
      112deg,
      transparent 40%,
      color-mix(in srgb, var(--ivory) 22%, transparent) 50%,
      transparent 60%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  :global(html[data-motion-ready])
    .home-hero[data-motion-state='entered']
    .home-hero__heading::after {
    animation: hero-light-sweep 620ms var(--ease-cinematic) both;
  }

  @keyframes hero-light-sweep {
    0% {
      opacity: 0;
      transform: translateX(-60%);
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(60%);
    }
  }

  .home-hero :global(eclipse-countdown) {
    --eclipse-size: var(--hero-frame);
    /* 디스크 중심이 h1과 겹치므로 라벨 묶음을 우하향으로 밀어 텍스트를 피한다 */
    --eclipse-label-x: calc(var(--hero-frame) * 0.09);
    --eclipse-label-y: calc(var(--hero-frame) * 0.16);
    position: absolute;
    top: var(--hero-frame-top);
    right: var(--hero-frame-right);
    z-index: 0;
  }

  h1 {
    margin-top: 0.8rem;
    font-size: calc(var(--type-scale) * var(--hero-h1));
    letter-spacing: 0.01em;
    line-height: 0.82;
    text-wrap: initial;
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  /* 아웃라인 텍스트. 획 색 = 코로나 림 그라데이션(금 → 주황 → 갈색).
     background-clip: text 는 stroke 영역까지 칠하고, 채움색(--night)이 안쪽 절반을 덮어
     바깥 절반만 그라데이션 획으로 남는다 → 획 폭을 2배로 둔다. */
  .home-hero__dawn {
    -webkit-text-stroke: max(2px, 0.028em) transparent;
    background: linear-gradient(
      90deg,
      #f6d78a,
      #f0b352 30%,
      #e08a3a 60%,
      #b8642c 85%,
      #7a4a2c
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--night);
  }

  .home-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    align-items: center;
    max-width: 34rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    color: var(--mist);
    font-size: calc(var(--type-scale) * clamp(1rem, 2vw, 1.25rem));
    font-weight: 700;
    text-shadow: 0 1px 12px var(--night);
  }

  .home-hero__facts a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--amber);
    font-weight: 800;
  }

  @media (max-width: 42rem) {
    .home-hero {
      min-height: 42rem;
    }

    .home-hero__content {
      grid-template-columns: 1fr;
      align-content: space-between;
    }

    .home-hero {
      /* 세로: 이전 디스크 중심(100% + 5rem − 3.1em) 유지. 가로: 정중앙 */
      --hero-frame-top: calc(
        100% + 5rem - 3.1 * var(--hero-h1) - var(--hero-frame) / 2
      );
      --hero-frame-right: calc(50% - var(--hero-frame) / 2);
    }

    .home-hero :global(eclipse-countdown) {
      --eclipse-label-x: 0px;
      --eclipse-label-y: 0px;
    }
  }
</style>
