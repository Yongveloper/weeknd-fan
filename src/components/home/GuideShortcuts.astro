---
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale).home.shortcuts;
const shortcuts = [
  ['/goyang/#official', strings.official],
  ['/goyang/#transport', strings.directions],
  ['/goyang/#seating', strings.seating],
  ['/goyang/#packing', strings.packing],
  ['/goyang/#return', strings.returning],
] as const;
---

<section
  id="goyang-guide"
  class="guide-shortcuts fold"
  data-motion-scene-enter
  aria-labelledby="guide-shortcuts-title"
>
  <div class="shell-content guide-shortcuts__inner">
    <div class="guide-shortcuts__heading">
      <h2 id="guide-shortcuts-title">{strings.heading}</h2>
    </div>
    <nav aria-label={strings.navAriaLabel}>
      {
        shortcuts.map(([href, label], index) => (
          <a href={href} style={`--i: ${index}`}>
            {label} <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .guide-shortcuts {
    padding-block: var(--section-space);
  }

  .guide-shortcuts__inner {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
  }

  h2 {
    margin-top: 0;
  }

  nav {
    display: grid;
  }

  a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding-block: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
    color: var(--ivory);
    font-size: calc(var(--type-scale) * clamp(1.15rem, 2vw, 1.4rem));
    font-weight: 800;
    text-decoration: none;
  }

  a:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent);
  }

  .guide-shortcuts::after {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--amber), transparent);
    content: '';
    opacity: 0.35;
    transform-origin: left;
    pointer-events: none;
  }

  :global(html[data-motion-ready])
    .guide-shortcuts:not([data-motion-state='entered'])
    nav
    a {
    opacity: 0;
    transform: translateY(10px);
  }

  :global(html[data-motion-ready])
    .guide-shortcuts[data-motion-state='entered']::after {
    animation: horizon-draw 600ms var(--ease-cinematic) both;
  }

  :global(html[data-motion-ready])
    .guide-shortcuts[data-motion-state='entered']
    nav
    a {
    animation: shortcut-rise 420ms var(--ease-cinematic) both;
    animation-delay: calc(var(--i, 0) * 60ms + 120ms);
  }

  @keyframes horizon-draw {
    from {
      opacity: 1;
      transform: scaleX(0);
    }
    60% {
      opacity: 1;
    }
    to {
      opacity: 0.35;
      transform: scaleX(1);
    }
  }

  @keyframes shortcut-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 42rem) {
    .guide-shortcuts__inner {
      grid-template-columns: 1fr;
    }

    .guide-shortcuts__heading {
      justify-self: start;
    }
  }
</style>
