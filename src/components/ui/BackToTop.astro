---
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale).ui;
---

<back-to-top>
  <button
    class="back-to-top"
    type="button"
    aria-label={strings.backToTop}
    data-back-to-top
    hidden
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m6 14 6-6 6 6" fill="none" stroke="currentColor" stroke-width="2"
      ></path>
    </svg>
  </button>
</back-to-top>
