---
import AlbumCover from '../content/AlbumCover.astro';
import type { AlbumRecord } from '../../lib/content/contracts';
import { findAlbumByTitle } from '../../lib/content/albums';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
  albums: AlbumRecord[];
}

const { locale, albums } = Astro.props;
const pick = (titles: string[]) =>
  titles
    .map((title) => findAlbumByTitle(albums, title))
    .filter((album): album is AlbumRecord => Boolean(album));
const early = pick(['House of Balloons', 'Thursday', 'Echoes of Silence']);
const recent = pick(['After Hours', 'Dawn FM', 'Hurry Up Tomorrow']);
const strings = ui(locale).discover.trilogy;
// The compilation title stays in its own <em>, so split the sentence around it
// instead of assembling the sentence from translated fragments.
const [earlyBodyBefore = '', earlyBodyAfter = ''] =
  strings.early.body.split('{album}');
const [interpretationBefore = '', interpretationAfter = ''] =
  strings.interpretation.body.split('{emphasis}');
---

<section class="trilogies" aria-labelledby="trilogy-title">
  <div class="trilogies__intro">
    <h2 id="trilogy-title">{strings.title}</h2>
    <p>{strings.intro}</p>
  </div>
  <div class="trilogies__sequence">
    <section aria-labelledby="early-trilogy-title">
      <p class="eyebrow">2011 MIXTAPES</p>
      <h3 id="early-trilogy-title">{strings.early.heading}</h3>
      <ul class="trilogies__covers" aria-label={strings.early.coversAriaLabel}>
        {
          early.map((album) => (
            <li>
              <AlbumCover locale={locale} album={album} size={120} />
            </li>
          ))
        }
      </ul>
      <p>House of Balloons → Thursday → Echoes of Silence</p>
      <p>{earlyBodyBefore}<em>Trilogy</em>{earlyBodyAfter}</p>
    </section>
    <section aria-labelledby="recent-trilogy-title">
      <p class="eyebrow">STUDIO ALBUMS</p>
      <h3 id="recent-trilogy-title">{strings.recent.heading}</h3>
      <ul class="trilogies__covers" aria-label={strings.recent.coversAriaLabel}>
        {
          recent.map((album) => (
            <li>
              <AlbumCover locale={locale} album={album} size={120} />
            </li>
          ))
        }
      </ul>
      <p>After Hours → Dawn FM → Hurry Up Tomorrow</p>
      <p>{strings.recent.body}</p>
    </section>
  </div>
  <aside
    class="trilogies__interpretation"
    aria-label={strings.interpretation.ariaLabel}
  >
    <p class="eyebrow">{strings.interpretation.eyebrow}</p>
    <p>
      {interpretationBefore}<strong>{strings.interpretation.emphasis}</strong>{
        interpretationAfter
      }
    </p>
  </aside>
</section>

<style>
  .trilogies {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: var(--section-space);
    border-top: 1px solid color-mix(in srgb, var(--ivory) 20%, transparent);
  }

  .trilogies__intro {
    display: grid;
    gap: 0.8rem;
    max-width: 47rem;
  }

  h2,
  h3 {
    margin: 0;
  }

  h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .trilogies__intro > p:last-child,
  .trilogies__sequence p,
  .trilogies__interpretation p:last-child {
    margin: 0;
    color: var(--mist);
  }

  .trilogies__sequence {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 7vw, 7rem);
  }

  .trilogies__sequence section {
    display: grid;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 3px solid var(--amber);
  }

  .trilogies__sequence section + section {
    border-color: color-mix(in srgb, var(--amber) 45%, var(--ivory));
  }

  /* Three equal tracks, capped at the covers' full size. A wrapping flex row
     dropped the third cover onto a row of its own once the three no longer
     fit side by side; equal tracks let all three share the width instead. */
  .trilogies__covers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: calc(120px * 3 + 1.5rem);
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }

  .trilogies__sequence section p:nth-of-type(2) {
    color: var(--ivory);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 800;
  }

  .trilogies__interpretation {
    display: grid;
    gap: 0.5rem;
    max-width: 47rem;
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--amber) 45%, transparent);
  }

  .trilogies__interpretation strong {
    color: var(--ivory);
  }

  @media (max-width: 42rem) {
    .trilogies__sequence {
      grid-template-columns: 1fr;
    }
  }
</style>
