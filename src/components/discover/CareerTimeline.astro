---
import { render, type CollectionEntry } from 'astro:content';
import AlbumCover from '../content/AlbumCover.astro';
import SourceList from '../content/SourceList.astro';
import StatusBadge from '../content/StatusBadge.astro';
import type { AlbumRecord, SourceRecord } from '../../lib/content/contracts';
import { findAlbumByTitle } from '../../lib/content/albums';
import { resolveSourceReferences } from '../../lib/content/queries';
import Disclosure from '../ui/Disclosure.astro';

interface Props {
  entries: CollectionEntry<'discover'>[];
  sources: SourceRecord[];
  albums: AlbumRecord[];
}

const { entries, sources, albums } = Astro.props;
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    sources: resolveSourceReferences(entry.data.sources, sources),
    covers: entry.data.relatedAlbums
      .map((title) => findAlbumByTitle(albums, title))
      .filter((album): album is AlbumRecord => Boolean(album)),
  })),
);
---

<ol class="timeline" aria-label="The Weeknd 시대별 커리어">
  {
    renderedEntries.map(({ entry, Content, sources: entrySources, covers }) => (
      <li class="timeline__entry">
        <div class="timeline__summary">
          <p class="eyebrow">{entry.data.title.split('·')[0]?.trim()}</p>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.summary}</p>
          {covers.length > 0 && (
            <ul
              class="timeline__covers"
              aria-label={`${entry.data.title} 앨범`}
            >
              {covers.map((album) => (
                <li>
                  <AlbumCover album={album} size={72} />
                </li>
              ))}
            </ul>
          )}
          <StatusBadge status={entry.data.status} />
        </div>
        <Disclosure
          ariaLabel={`${entry.data.title} 더 깊이 보기`}
          label="더 깊이 보기"
          class="timeline__disclosure"
        >
          <div class="timeline__detail">
            <Content />
            <SourceList sources={entrySources} />
          </div>
        </Disclosure>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem 2rem;
    padding-block: clamp(2rem, 6vw, 4rem);
    border-top: 1px solid color-mix(in srgb, var(--ivory) 20%, transparent);
  }

  .timeline__summary {
    display: grid;
    gap: 0.7rem;
    max-width: 46rem;
  }

  h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
  }

  .timeline__summary > p:not(.eyebrow) {
    color: var(--mist);
  }

  .timeline__covers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline__disclosure {
    align-self: end;
    min-width: 11rem;
  }

  .timeline__detail {
    display: grid;
    gap: 0.85rem;
    max-width: 44rem;
    padding-block: 1rem 0.4rem;
    color: var(--mist);
  }

  .timeline__detail :global(p) {
    margin: 0;
  }

  @media (max-width: 42rem) {
    .timeline__entry {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .timeline__disclosure {
      min-width: 0;
    }
  }
</style>
