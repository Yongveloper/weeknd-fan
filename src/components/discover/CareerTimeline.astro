---
import { render, type CollectionEntry } from 'astro:content';
import AlbumCover from '../content/AlbumCover.astro';
import SourceList from '../content/SourceList.astro';
import type { AlbumRecord, SourceRecord } from '../../lib/content/contracts';
import { findAlbumByTitle } from '../../lib/content/albums';
import { resolveSourceReferences } from '../../lib/content/queries';
import Disclosure from '../ui/Disclosure.astro';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';
import { ARTIST } from '../../lib/i18n/proper-nouns';

interface Props {
  locale: Locale;
  entries: CollectionEntry<'discover'>[];
  sources: SourceRecord[];
  albums: AlbumRecord[];
}

const { locale, entries, sources, albums } = Astro.props;
const strings = ui(locale).discover.timeline;
const discoverStrings = ui(locale).discover;
const careerAriaLabel = strings.careerAriaLabel.replace('{artist}', ARTIST);
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    sources: resolveSourceReferences(entry.data.sources, sources),
    covers: entry.data.relatedAlbums
      .map((title) => findAlbumByTitle(albums, title))
      .filter((album): album is AlbumRecord => Boolean(album)),
  })),
);
---

<ol class="timeline" aria-label={careerAriaLabel}>
  {
    renderedEntries.map(({ entry, Content, sources: entrySources, covers }) => (
      <li class="timeline__entry">
        <div class="timeline__summary">
          <p class="eyebrow">{entry.data.title.split('·')[0]?.trim()}</p>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.summary}</p>
          {covers.length > 0 && (
            <ul
              class="timeline__covers"
              aria-label={strings.coversAriaLabel.replace(
                '{era}',
                entry.data.title,
              )}
            >
              {covers.map((album) => (
                <li>
                  <AlbumCover locale={locale} album={album} size={72} />
                </li>
              ))}
            </ul>
          )}
        </div>
        <Disclosure
          ariaLabel={strings.disclosureAriaLabel.replace(
            '{era}',
            entry.data.title,
          )}
          label={discoverStrings.disclosureLabel}
          class="timeline__disclosure"
        >
          <div class="timeline__detail">
            <Content />
            <SourceList locale={locale} sources={entrySources} />
          </div>
        </Disclosure>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Single column: putting the disclosure in a right-hand auto column shifts
     that column's width when it opens, reflowing the whole left summary
     (a layout shift on desktop). Keep it below the summary at the same width. */
  .timeline__entry {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2rem, 6vw, 4rem);
    border-top: 1px solid color-mix(in srgb, var(--ivory) 20%, transparent);
  }

  .timeline__summary {
    display: grid;
    gap: 0.7rem;
    max-width: 46rem;
  }

  h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
  }

  .timeline__summary > p:not(.eyebrow) {
    color: var(--mist);
  }

  .timeline__covers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline__entry :global(.timeline__disclosure) {
    max-width: 46rem;
  }

  .timeline__detail {
    display: grid;
    gap: 0.85rem;
    max-width: 44rem;
    color: var(--mist);
  }

  .timeline__detail :global(p) {
    margin: 0;
  }

  @media (max-width: 42rem) {
    .timeline__entry {
      gap: 0.9rem;
    }
  }
</style>
