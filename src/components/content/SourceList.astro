---
import type { SourceRecord } from '../../lib/content/contracts';
import { formatSeoulDate } from '../../lib/content/audit';

interface Props {
  sources: SourceRecord[];
}

const { sources } = Astro.props;
---

<ul class="source-list" aria-label="출처">
  {
    sources.map((source) => (
      <li>
        {'medium' in source.data && source.data.medium === 'sms' ? (
          <>
            <span class="source-list__message">{source.data.name}</span>
            <span>수신일 {formatSeoulDate(source.data.receivedAt)}</span>
          </>
        ) : (
          <>
            <a href={source.data.url} target="_blank" rel="noreferrer">
              {source.data.name}
            </a>
            <span>
              마지막 확인 {formatSeoulDate(source.data.lastCheckedAt)}
            </span>
          </>
        )}
      </li>
    ))
  }
</ul>

<style>
  .source-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    color: var(--ink-muted);
    font-size: 0.82rem;
    list-style: none;
  }

  .source-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    align-items: baseline;
  }

  .source-list a {
    color: var(--ivory);
    font-weight: 700;
  }

  .source-list__message {
    color: var(--ivory);
    font-weight: 700;
  }
</style>
