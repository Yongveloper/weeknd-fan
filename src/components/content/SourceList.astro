---
import type { SourceRecord } from '../../lib/content/contracts';
import { formatSeoulDate } from '../../lib/content/audit';
import type { Locale } from '../../lib/i18n/locales';
import { ui } from '../../lib/i18n/ui';

interface Props {
  locale: Locale;
  sources: SourceRecord[];
}

const { locale, sources } = Astro.props;
const strings = ui(locale).content.sourceList;
---

<ul class="source-list" aria-label={strings.ariaLabel}>
  {
    sources.map((source) => (
      <li>
        {'medium' in source.data && source.data.medium === 'sms' ? (
          <>
            <span class="source-list__message">{source.data.name}</span>
            <span>
              {strings.receivedOn.replace(
                '{date}',
                formatSeoulDate(source.data.receivedAt),
              )}
            </span>
          </>
        ) : (
          <>
            <a href={source.data.url} target="_blank" rel="noreferrer">
              {source.data.name}
            </a>
            <span>
              {strings.lastChecked.replace(
                '{date}',
                formatSeoulDate(source.data.lastCheckedAt),
              )}
            </span>
          </>
        )}
      </li>
    ))
  }
</ul>

<style>
  .source-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    color: var(--ink-muted);
    font-size: 0.82rem;
    list-style: none;
  }

  .source-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    align-items: baseline;
  }

  .source-list a {
    color: var(--ivory);
    font-weight: 700;
  }

  .source-list__message {
    color: var(--ivory);
    font-weight: 700;
  }
</style>
