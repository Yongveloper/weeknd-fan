---
interface Props {
  url: string;
  songTitle: string;
}

const { url, songTitle } = Astro.props;
const allowedProviders = new Set([
  'www.youtube.com',
  'youtube.com',
  'www.youtube-nocookie.com',
  'youtube-nocookie.com',
  'open.spotify.com',
]);

const provider = new URL(url);
if (
  provider.protocol !== 'https:' ||
  !allowedProviders.has(provider.hostname)
) {
  throw new Error(`Unsupported official media provider: ${provider.hostname}`);
}
---

<official-embed
  class="official-embed"
  data-embed-url={url}
  data-song-title={songTitle}
>
  <a href={url} target="_blank" rel="noreferrer">공식 원문에서 듣기</a>
  <button type="button" data-load-embed>공식 영상 불러오기</button>
</official-embed>

<script is:inline>
  (() => {
    if (window.__officialEmbedEnhancement) return;
    window.__officialEmbedEnhancement = true;
    const timeoutMs = 8_000;
    const allowedProviders = new Set([
      'www.youtube.com',
      'youtube.com',
      'www.youtube-nocookie.com',
      'youtube-nocookie.com',
      'open.spotify.com',
    ]);

    const activeEmbeds = new Map();
    const cleanup = (embed) => {
      const state = activeEmbeds.get(embed);
      if (!state) return;
      window.clearTimeout(state.timeout);
      state.iframe.removeEventListener('load', state.onLoad);
      state.iframe.removeEventListener('error', state.onError);
      state.iframe.remove();
      activeEmbeds.delete(embed);
    };

    document.addEventListener('click', (event) => {
      const button = event.target.closest('official-embed [data-load-embed]');
      const embed = button?.closest('official-embed');
      if (!embed || activeEmbeds.has(embed)) return;

      const url = embed.dataset.embedUrl;
      const songTitle = embed.dataset.songTitle;
      if (!url || !songTitle) return;

      let mediaUrl;
      try {
        mediaUrl = new URL(url);
      } catch {
        return;
      }
      if (
        mediaUrl.protocol !== 'https:' ||
        !allowedProviders.has(mediaUrl.hostname)
      ) {
        return;
      }

      const iframe = document.createElement('iframe');
      iframe.loading = 'lazy';
      iframe.title = `${songTitle} 공식 미디어`;
      iframe.src = mediaUrl.href;
      iframe.allow = 'encrypted-media; fullscreen; picture-in-picture';
      iframe.sandbox.add('allow-same-origin', 'allow-scripts');
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      const state = {
        iframe,
        timeout: undefined,
        onLoad: undefined,
        onError: undefined,
      };
      state.onLoad = () => window.clearTimeout(state.timeout);
      state.onError = () => cleanup(embed);
      iframe.addEventListener('load', state.onLoad, { once: true });
      iframe.addEventListener('error', state.onError, { once: true });
      state.timeout = window.setTimeout(() => cleanup(embed), timeoutMs);
      activeEmbeds.set(embed, state);
      button.insertAdjacentElement('afterend', iframe);
    });

    new MutationObserver((records) => {
      records.forEach((record) =>
        record.removedNodes.forEach((node) => {
          activeEmbeds.forEach((_, embed) => {
            if (node === embed || (node.nodeType === 1 && node.contains(embed)))
              cleanup(embed);
          });
        }),
      );
    }).observe(document, { childList: true, subtree: true });
  })();
</script>

<style>
  .official-embed {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  a,
  button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ivory);
    font: inherit;
    font-weight: 800;
  }

  button {
    padding: 0.4rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--blue) 80%, transparent);
    background: transparent;
    cursor: pointer;
  }

  iframe {
    width: min(100%, 36rem);
    min-height: 12rem;
    border: 0;
  }
</style>
