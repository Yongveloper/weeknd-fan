---
import SetlistExplorer from '../components/setlist/SetlistExplorer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  getAlbums,
  getConcert,
  getExpectedSetlist,
  getShowRecords,
} from '../lib/content/queries';

const [concert, entries, showRecords, sources, albums] = await Promise.all([
  getConcert(),
  getExpectedSetlist(),
  getShowRecords(),
  getCollection('sources'),
  getAlbums(),
]);
const archivePublished = concert.data.archivePublished;
const title = archivePublished
  ? 'WE WERE HERE | The Weeknd 고양 팬 가이드'
  : '예상 셋리스트 | The Weeknd 고양 팬 가이드';
---

<BaseLayout
  cloudSky
  title={title}
  description="최근 2026년 공연 기록을 바탕으로 한 The Weeknd 고양 공연 예상 셋리스트"
>
  <section
    class="setlist-page shell-content"
    aria-labelledby="setlist-page-title"
  >
    <header>
      <p class="eyebrow">EXPECTED SHOW GUIDE</p>
      <h1 id="setlist-page-title">
        {archivePublished ? '우리는 그곳에 있었다' : '예상 셋리스트'}
      </h1>
      <p>
        최근 무대의 반복 패턴을 참고한 비공식 예상 순서입니다. 실제 공연은
        달라질 수 있어요.
      </p>
    </header>
    <SetlistExplorer
      entries={entries}
      showRecords={showRecords}
      sources={sources}
      archivePublished={archivePublished}
      albums={albums}
    />
  </section>
</BaseLayout>

<style>
  .setlist-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .setlist-page > *,
  .setlist-page :global(.setlist-explorer),
  .setlist-page :global(.expected-setlist),
  .setlist-page :global(.actual-setlist) {
    min-width: 0;
  }

  .setlist-page :global(.setlist-filter) {
    width: 100%;
  }

  .setlist-page :global(.setlist-filter) > * {
    min-width: 0;
  }

  .setlist-page :global(.setlist-filter) label,
  .setlist-page :global(.setlist-filter) input,
  .setlist-page :global(.setlist-filter) select {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  header {
    display: grid;
    gap: 1rem;
    max-width: 56rem;
  }

  h1 {
    margin: 0;
  }

  header > p:last-child {
    max-width: 44rem;
    margin: 0;
    color: var(--mist);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
</style>
