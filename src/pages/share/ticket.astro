---
import TicketBuilder from '../../components/share/TicketBuilder.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getConcert, getExpectedSetlist } from '../../lib/content/queries';

const [concert, expectedSetlist] = await Promise.all([
  getConcert(),
  getExpectedSetlist(),
]);
const showDates = concert.data.shows.map((show) =>
  show.startsAt.slice(0, 10),
) as [string, string];
const showStarts = concert.data.shows.map((show) => show.startsAt) as [
  string,
  string,
];
const songs = expectedSetlist.map((entry) => entry.data.songTitle);
---

<BaseLayout
  title="D-day Ticket | The Weeknd 고양 팬 가이드"
  description="브라우저 안에서만 생성하는 The Weeknd 고양 D-day 티켓"
>
  <div class="shell-content">
    <TicketBuilder {showDates} {showStarts} {songs} />
  </div>
</BaseLayout>
