---
import SetlistCardBuilder from '../../components/share/SetlistCardBuilder.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getConcert, getExpectedSetlist } from '../../lib/content/queries';

const [concert, expectedSetlist] = await Promise.all([
  getConcert(),
  getExpectedSetlist(),
]);
const version = concert.data.lastVerifiedAt.toISOString().slice(0, 10);
const songs = expectedSetlist.map((entry) => entry.data.songTitle);
---

<BaseLayout
  title="Setlist Card | The Weeknd 고양 팬 가이드"
  description="브라우저 안에서만 생성하는 The Weeknd 고양 예상 셋리스트 카드"
>
  <div class="shell-content">
    <SetlistCardBuilder {version} {songs} />
  </div>
</BaseLayout>
