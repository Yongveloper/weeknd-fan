---
import { getCollection } from 'astro:content';
import AccessMap from '../../components/guide/AccessMap.astro';
import AccessTable from '../../components/guide/AccessTable.astro';
import DirectionsLinks from '../../components/guide/DirectionsLinks.astro';
import GuideJumpNav from '../../components/guide/GuideJumpNav.astro';
import GuideOverview from '../../components/guide/GuideOverview.astro';
import GuideSection from '../../components/guide/GuideSection.astro';
import LiveMap from '../../components/guide/LiveMap.astro';
import SeatMap from '../../components/guide/SeatMap.astro';
import TipsTabs from '../../components/guide/TipsTabs.astro';
import TransportOperations from '../../components/guide/TransportOperations.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGuideContent } from '../../lib/content/queries';
import { localeFromParam, localePaths } from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import { ARTIST } from '../../lib/i18n/proper-nouns';

export const getStaticPaths = localePaths;

const locale = localeFromParam(Astro.params.locale);
const strings = ui(locale).guide;
const pageTitle = strings.page.title.replace('{artist}', ARTIST);
const pageDescription = strings.page.description.replace('{artist}', ARTIST);
const [guides, sources] = await Promise.all([
  getGuideContent(),
  getCollection('sources'),
]);
const tips = guides.filter((entry) => entry.data.section === 'tips');
const sections = guides.filter((entry) => entry.data.section !== 'tips');
const jump = [
  ...sections.map((entry) => ({
    id: entry.data.section,
    label: entry.data.title,
    order: entry.data.order,
  })),
  { id: 'tips', label: strings.tips.heading, order: tips[0]?.data.order ?? 30 },
].sort((a, b) => a.order - b.order);
const overviewItems = jump.map(({ id, label }) => {
  const entry =
    id === 'tips' ? tips[0] : sections.find((item) => item.data.section === id);
  if (!entry)
    throw new Error(`Missing guide metadata for overview section: ${id}`);
  return { id, label, status: entry.data.status };
});
---

<BaseLayout
  locale={locale}
  cloudSky
  title={pageTitle}
  description={pageDescription}
>
  <section
    class="guide-page shell-content"
    aria-labelledby="goyang-guide-title"
  >
    <header>
      <p class="eyebrow">CONCERT GUIDE</p><h1 id="goyang-guide-title">
        {strings.page.heading}
      </h1><p>
        {strings.page.intro}
      </p>
    </header>
    <GuideOverview locale={locale} items={overviewItems} />
    <div class="guide-body">
      <GuideJumpNav locale={locale} items={jump} />
      {
        sections.map((entry) => (
          <>
            <GuideSection locale={locale} entry={entry} sources={sources}>
              {entry.data.section === 'transport' && (
                <div class="guide-transport-lead" slot="lead">
                  <TransportOperations locale={locale} />
                  <AccessTable locale={locale} />
                </div>
              )}
              {entry.data.section === 'transport' && (
                <div class="guide-transport">
                  <AccessMap locale={locale} />
                  <DirectionsLinks locale={locale} />
                  <LiveMap locale={locale} />
                </div>
              )}
              {entry.data.section === 'seating' && <SeatMap locale={locale} />}
            </GuideSection>
            {entry.data.section === 'seating' && (
              <TipsTabs locale={locale} entries={tips} sources={sources} />
            )}
          </>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .guide-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .guide-page > *,
  .guide-page :global(.guide-body),
  .guide-page :global(.guide-body) > *,
  .guide-page :global(.guide-section),
  .guide-page :global(.guide-section__heading),
  .guide-page :global(.guide-section) > *,
  .guide-page :global(.access-table),
  .guide-page :global(.access-table) > *,
  .guide-page :global(.guide-overview),
  .guide-page :global(.guide-overview) > * {
    min-width: 0;
  }

  .guide-page :global(.guide-body) {
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }

  .guide-page :global(.guide-section) {
    grid-template-columns: minmax(0, 1fr);
  }

  .guide-page :global(.access-table__row) {
    grid-template-columns: minmax(0, 1fr);
  }

  .guide-page :global(.access-map),
  .guide-page :global(.directions),
  .guide-page :global(.live-map),
  .guide-page :global(.live-map__note) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .guide-page :global(.access-map img) {
    max-width: 100%;
  }

  .guide-page :global(.directions a) {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  header {
    display: grid;
    gap: 1rem;
    max-width: 58rem;
  }
  /* The jump nav sticks for the whole body, so a 9,000px page stays navigable
     without scrolling back to the top. Sections offset their anchors to clear it. */
  .guide-body {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }
  :global(.guide-jump) {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    width: calc(100% + (var(--gutter) * 2));
    min-width: 0;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.6rem var(--gutter);
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 14%, transparent);
    /* Share the parent's glass exactly: a second tint, blur or saturation
       pass makes this strip darker than the surrounding reading surface. */
    isolation: isolate;
    background: transparent;
  }
  :global(.guide-jump::before) {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: #000;
    /* Scroll distance drives opacity directly, so reversing or stopping the
       scroll never leaves a time-based fade catching up behind the user. */
    opacity: var(--guide-stickiness, 0);
  }
  @media (max-width: 44rem) {
    :global(.guide-jump nav) {
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 0.5rem,
        #000 calc(100% - 1.75rem),
        transparent
      );
      scroll-padding-inline: var(--gutter) 3rem;
    }
  }
  :global(.guide-jump a) {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ivory) 24%, transparent);
    border-radius: 999px;
    color: var(--mist);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  :global(.guide-jump nav) {
    display: flex;
    flex-wrap: nowrap;
    min-width: 0;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    width: 100%;
  }
  :global(.guide-jump nav::-webkit-scrollbar) {
    display: none;
  }
  :global(.guide-jump a:hover),
  :global(.guide-jump a:focus-visible) {
    border-color: var(--amber);
    color: var(--ivory);
  }
  .guide-transport {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  .guide-transport-lead {
    display: grid;
    min-width: 0;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  header > p:last-child {
    max-width: 44rem;
    color: var(--mist);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
</style>
