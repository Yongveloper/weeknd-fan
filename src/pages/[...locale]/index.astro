---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/eclipse-impact.css';
import FanNote from '../../components/home/FanNote.astro';
import GuideShortcuts from '../../components/home/GuideShortcuts.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import PamphletContents from '../../components/home/PamphletContents.astro';
import IntroSummary from '../../components/home/IntroSummary.astro';
import SetlistPreview from '../../components/home/SetlistPreview.astro';
import DawnSky from '../../components/visual/DawnSky.astro';
import {
  getAlbums,
  getConcert,
  getExpectedSetlist,
  getSetlistEditorialMetadata,
} from '../../lib/content/queries';
import { buildEventJsonLd, serializeJsonLd } from '../../lib/seo/eventJsonLd';
import { localeFromParam, localePaths } from '../../lib/i18n/routes';

export const getStaticPaths = localePaths;

const locale = localeFromParam(Astro.params.locale);
void locale;

const title = 'The Weeknd 고양 팬 가이드';
const concert = await getConcert();
const albums = await getAlbums();
const setlist = await getExpectedSetlist();
const { observationCount } = getSetlistEditorialMetadata(setlist);
const eventJsonLd = buildEventJsonLd(
  concert.data,
  (Astro.site ?? Astro.url).toString(),
);
const sources = await getCollection('sources');
const officialNoticeUrl = sources.find((source) => source.id === 'nol-notice')
  ?.data.url;
if (!officialNoticeUrl) throw new Error('Missing source record: nol-notice');
---

<BaseLayout
  title={title}
  description="The Weeknd 2026 고양 공연을 위한 비공식·비영리 팬 가이드"
  spaceSky
  lunarSky
  coverCdn
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(eventJsonLd)}
  />
  {
    /* The cover sky scrolls away with the hero; this fixed sky stays behind
      the programme sheet, exactly as on the reading routes. */
  }
  <DawnSky readingOnly />
  <HomeHero />
  <div class="reading-panel" data-reading-panel>
    <div class="edition-directory">
      <PamphletContents officialNoticeUrl={officialNoticeUrl} />
    </div>
    <div class="edition-chapters">
      <IntroSummary albums={albums} />
      <SetlistPreview entries={setlist} previewCount={6} {observationCount} />
      <GuideShortcuts />
      <FanNote />
    </div>
  </div>
</BaseLayout>

<style>
  .reading-panel {
    position: relative;
    z-index: 4;
    padding-top: clamp(1rem, 3vw, 2.5rem);
    padding-bottom: var(--section-space);
    background: rgb(5 5 4 / 78%);
    border-top: 1px solid rgb(188 160 113 / 22%);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .reading-panel :global(section) {
    scroll-margin-top: 2rem;
  }
  .reading-panel :global(.pamphlet-contents) {
    border-top: 0;
  }
</style>
