---
import { getCollection, render } from 'astro:content';
import AlbumCover from '../../components/content/AlbumCover.astro';
import SourceList from '../../components/content/SourceList.astro';
import CareerTimeline from '../../components/discover/CareerTimeline.astro';
import TrilogyExplainer from '../../components/discover/TrilogyExplainer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclosure from '../../components/ui/Disclosure.astro';
import {
  getAlbums,
  getDiscoverContent,
  resolveSourceReferences,
} from '../../lib/content/queries';
import { localeFromParam, localePaths } from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import { ARTIST } from '../../lib/i18n/proper-nouns';

export const getStaticPaths = localePaths;

const locale = localeFromParam(Astro.params.locale);
const discover = await getDiscoverContent();
const sources = await getCollection('sources');
const albums = await getAlbums();
const studioAlbums = albums.filter((album) => album.data.kind === 'studio');
const intro = discover.find((entry) => entry.data.section === 'intro');
const eras = discover.filter((entry) => entry.data.section === 'era');
const glossary = discover.find((entry) => entry.data.section === 'glossary');
const visual = discover.find((entry) => entry.data.section === 'visual');

if (!intro || !glossary || !visual) {
  throw new Error('Missing required discover content');
}

const { Content: IntroContent } = await render(intro);
const { Content: GlossaryContent } = await render(glossary);
const { Content: VisualContent } = await render(visual);
const introSources = resolveSourceReferences(intro.data.sources, sources);
const glossarySources = resolveSourceReferences(glossary.data.sources, sources);
const visualSources = resolveSourceReferences(visual.data.sources, sources);
const strings = ui(locale).discover;
const pageTitle = strings.page.title.replaceAll('{artist}', ARTIST);
const pageDescription = strings.page.description.replace('{artist}', ARTIST);
// The artist name and the emphasized phrase each keep their own styled span,
// so split the sentence around both slots instead of assembling it from
// translated fragments.
const [heroBeforeArtist = '', heroAfterArtist = ''] =
  strings.hero.heading.split('{artist}');
const [heroBeforePhrase = '', heroAfterPhrase = ''] =
  heroAfterArtist.split('{phrase}');
const [albumsNoteBeforeTrilogy = '', albumsNoteAfterTrilogy = ''] =
  strings.albums.note.split('{trilogy}');
const [albumsNoteBeforeMdm = '', albumsNoteAfterMdm = ''] =
  albumsNoteAfterTrilogy.split('{mdm}');
---

<BaseLayout
  locale={locale}
  cloudSky
  coverCdn
  title={pageTitle}
  description={pageDescription}
>
  <article class="discover shell-content">
    <header class="discover__hero">
      <p class="eyebrow">THREE MINUTES BEFORE THE SHOW</p>
      <h1>
        {heroBeforeArtist}<span class="latin">{ARTIST}</span>{
          heroBeforePhrase
        }<span class="discover__hero-phrase">{strings.hero.phrase}</span>{
          heroAfterPhrase
        }
      </h1>
      <p>{intro.data.summary}</p>
      <Disclosure
        locale={locale}
        ariaLabel={strings.hero.introDisclosureAriaLabel}
        label={strings.hero.introDisclosureLabel}
        class="discover__disclosure"
      >
        <IntroContent />
        <SourceList locale={locale} sources={introSources} />
      </Disclosure>
    </header>

    <section class="discover__albums" aria-labelledby="studio-albums-title">
      <h2 id="studio-albums-title">{strings.albums.heading}</h2>
      <ol aria-label={strings.albums.heading} data-enter-group>
        {
          studioAlbums.map((album) => (
            <li>
              <AlbumCover locale={locale} album={album} size={72} />
              <span>
                {album.data.year} · <em>{album.data.title}</em>
              </span>
            </li>
          ))
        }
      </ol>
      <p>
        {albumsNoteBeforeTrilogy}<em>Trilogy</em>{albumsNoteBeforeMdm}<em
          >My Dear Melancholy,</em
        >{albumsNoteAfterMdm}
      </p>
    </section>

    <TrilogyExplainer locale={locale} albums={albums} />

    <section class="discover__timeline" aria-labelledby="timeline-title">
      <h2 id="timeline-title">{strings.timeline.heading}</h2>
      <CareerTimeline
        locale={locale}
        entries={eras}
        sources={sources}
        albums={albums}
      />
    </section>

    <section class="discover__closing" aria-labelledby="glossary-title">
      <div>
        <h2 id="glossary-title">{glossary.data.title}</h2>
        <p>{glossary.data.summary}</p>
        <Disclosure
          locale={locale}
          ariaLabel={strings.glossary.disclosureAriaLabel}
          label={strings.disclosureLabel}
          class="discover__disclosure"
        >
          <GlossaryContent />
          <SourceList locale={locale} sources={glossarySources} />
        </Disclosure>
      </div>
      <div>
        <h2>{visual.data.title}</h2>
        <p>{visual.data.summary}</p>
        <Disclosure
          locale={locale}
          ariaLabel={strings.visual.disclosureAriaLabel}
          label={strings.disclosureLabel}
          class="discover__disclosure"
        >
          <VisualContent />
          <SourceList locale={locale} sources={visualSources} />
        </Disclosure>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .discover {
    padding-block: clamp(3rem, 9vw, 8rem) var(--section-space);
  }

  /* Allow long editorial strings to wrap when users enlarge text. */
  .discover > *,
  .discover__hero > *,
  .discover__albums > *,
  .discover__timeline > *,
  .discover__closing > * {
    min-width: 0;
  }

  .discover__hero,
  .discover__albums,
  .discover__timeline,
  .discover__closing {
    border-top: 1px solid color-mix(in srgb, var(--ivory) 20%, transparent);
  }

  .discover :global(.trilogies) {
    grid-template-columns: minmax(0, 1fr);
  }

  .discover :global(.trilogies) > *,
  .discover :global(.trilogies__intro) > *,
  .discover :global(.trilogies__sequence) > *,
  .discover :global(.trilogies__interpretation) > * {
    min-width: 0;
  }

  .discover :global(.timeline__entry),
  .discover :global(.timeline__summary),
  .discover :global(.timeline__detail) {
    min-width: 0;
  }

  .discover :global(.timeline__summary),
  .discover :global(.timeline__detail) {
    grid-template-columns: minmax(0, 1fr);
  }

  .discover__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0 var(--section-space);
    border-top: 0;
  }

  .discover__hero > p:not(.eyebrow) {
    max-width: 40rem;
    color: var(--mist);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .discover__hero-phrase {
    white-space: nowrap;
  }

  .discover :global(.discover__disclosure) {
    max-width: 42rem;
    color: var(--mist);
  }

  .discover__albums {
    display: grid;
    gap: 1rem;
    padding-block: var(--section-space);
  }

  .discover__albums ol {
    --enter-stagger: 90ms; /* Generous over the 60ms default so all six read one at a time */

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
    max-width: 58rem;
    margin: 0;
    padding: 1.25rem 0;
    border-block: 1px solid color-mix(in srgb, var(--ivory) 20%, transparent);
    list-style: none;
  }

  .discover__albums li {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    color: var(--mist);
  }

  .discover__albums > p:last-child {
    max-width: 48rem;
    color: var(--mist);
  }

  .discover__timeline {
    padding-top: var(--section-space);
  }

  .discover__timeline > .eyebrow,
  .discover__timeline > h2 {
    margin-bottom: 1rem;
  }

  .discover__closing {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 7vw, 7rem);
    padding-top: var(--section-space);
  }

  .discover__closing > div {
    display: grid;
    gap: 0.8rem;
    color: var(--mist);
  }

  .discover__closing :global(p) {
    margin: 0;
  }

  .discover__closing h2 {
    color: var(--ivory);
  }

  @media (max-width: 42rem) {
    .discover__albums ol,
    .discover__closing {
      grid-template-columns: 1fr;
    }
  }
</style>
