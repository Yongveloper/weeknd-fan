---
import SetlistExplorer from '../../components/setlist/SetlistExplorer.astro';
import StatusBadge from '../../components/content/StatusBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  getAlbums,
  getConcert,
  getExpectedSetlist,
  getShowRecords,
} from '../../lib/content/queries';
import { localeFromParam, localePaths } from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import { ARTIST } from '../../lib/i18n/proper-nouns';

export const getStaticPaths = localePaths;

const locale = localeFromParam(Astro.params.locale);
const [concert, entries, showRecords, sources, albums] = await Promise.all([
  getConcert(),
  getExpectedSetlist(),
  getShowRecords(),
  getCollection('sources'),
  getAlbums(),
]);
const archivePublished = concert.data.archivePublished;
const strings = ui(locale).setlist.page;
const title = (
  archivePublished ? strings.titleArchived : strings.titleExpected
).replaceAll('{artist}', ARTIST);
const description = strings.description.replace('{artist}', ARTIST);
---

<BaseLayout locale={locale} cloudSky title={title} description={description}>
  <section
    class="setlist-page shell-content"
    aria-labelledby="setlist-page-title"
  >
    <header>
      <p class="eyebrow">EXPECTED SHOW GUIDE</p>
      <h1 id="setlist-page-title">
        {archivePublished ? strings.headingArchived : strings.headingExpected}
      </h1>
      {!archivePublished && <StatusBadge locale={locale} status="expected" />}
      <p>{strings.intro}</p>
    </header>
    <SetlistExplorer
      locale={locale}
      entries={entries}
      showRecords={showRecords}
      sources={sources}
      archivePublished={archivePublished}
      albums={albums}
    />
  </section>
</BaseLayout>

<style>
  .setlist-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .setlist-page > *,
  .setlist-page :global(.setlist-explorer),
  .setlist-page :global(.expected-setlist),
  .setlist-page :global(.actual-setlist) {
    min-width: 0;
  }

  .setlist-page :global(.setlist-filter) {
    width: 100%;
  }

  .setlist-page :global(.setlist-filter) > * {
    min-width: 0;
  }

  .setlist-page :global(.setlist-filter) label,
  .setlist-page :global(.setlist-filter) input,
  .setlist-page :global(.setlist-filter) select {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  header {
    display: grid;
    gap: 1rem;
    max-width: 56rem;
  }

  h1 {
    margin: 0;
  }

  header > p:last-child {
    max-width: 44rem;
    margin: 0;
    color: var(--mist);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
</style>
