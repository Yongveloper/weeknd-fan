---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatSeoulDate } from '../../lib/content/audit';
import {
  getSourceUsageIndex,
  resolveSourceReferences,
} from '../../lib/content/queries';
import { sourcesOverlay } from '../../lib/i18n/content/overlays';
import { DEFAULT_LOCALE } from '../../lib/i18n/locales';
import {
  localeFromParam,
  localeHref,
  localePaths,
} from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import { ARTIST } from '../../lib/i18n/proper-nouns';

export const getStaticPaths = localePaths;

const locale = localeFromParam(Astro.params.locale);
const [allSources, sourceUsage] = await Promise.all([
  getCollection('sources'),
  getSourceUsageIndex(),
]);
// Translate each source's display name (when an overlay exists) without
// touching any other field — status, dates and kind stay the source of
// record regardless of locale.
const sources = resolveSourceReferences(
  allSources.map((source) => ({ id: source.id, collection: 'sources' })),
  allSources,
  locale,
);
// A per-row signal, not a single banner over the whole listing: this list
// mixes translated and untranslated names (they translate on their own
// schedule), so the "shown in Korean" marker has to travel with each row.
const sourceOverlay = sourcesOverlay(locale);
const isSourceTranslated = (id: string) => Boolean(sourceOverlay[id]);
const strings = ui(locale).sources;
const contentStrings = ui(locale).content;
const pageTitle = strings.page.title.replace('{artist}', ARTIST);
const pageDescription = strings.page.description.replace('{artist}', ARTIST);
const routeLabels = {
  '/': strings.routeLabels.home,
  '/discover/': ARTIST,
  '/setlist/': strings.routeLabels.setlist,
  '/goyang/': strings.routeLabels.goyang,
} as const;
type SourceEntry = (typeof sources)[number];
const isSmsSource = (
  source: SourceEntry,
): source is SourceEntry & {
  data: { medium: 'sms'; receivedAt: Date; sender: string; transcript: string };
} => 'medium' in source.data && source.data.medium === 'sms';
const sourceDate = (source: SourceEntry): Date => {
  if (isSmsSource(source)) return source.data.receivedAt;
  if (!source.data.lastCheckedAt) {
    throw new Error(`Missing source check date: ${source.id}`);
  }
  return source.data.lastCheckedAt;
};
/** One shared date per group keeps 40+ identical "last checked" lines out of the list. */
const sharedCheckedDate = (records: SourceEntry[]) => {
  const dates = new Set(
    records.map((source) => formatSeoulDate(sourceDate(source))),
  );
  return dates.size === 1 ? [...dates][0] : undefined;
};
const groups: Array<{
  id: string;
  title: string;
  description: string;
  kinds: string[];
  /** Non-linked closing row (the NamuWiki PDF note). */
  trailing?: { name: string; note: string };
}> = [
  {
    id: 'official',
    title: strings.kind.official.title,
    description: strings.kind.official.description,
    kinds: ['official'],
  },
  {
    id: 'public-agency',
    title: strings.kind['public-agency'].title,
    description: strings.kind['public-agency'].description,
    kinds: ['public-agency'],
  },
  {
    id: 'crowd-sourced',
    title: strings.kind['crowd-sourced'].title,
    description: strings.kind['crowd-sourced'].description,
    kinds: ['crowd-sourced'],
  },
  {
    id: 'supporting',
    title: strings.kind['editorial-reference'].title,
    description: strings.kind['editorial-reference'].description,
    kinds: ['editorial-reference'],
    trailing: strings.wikiReference,
  },
];

const checkpoints = strings.checkpoints.items;
---

<BaseLayout locale={locale} title={pageTitle} description={pageDescription}>
  <article class="sources-page shell-content">
    <header class="sources-page__hero">
      <p class="eyebrow">PROVENANCE / CHECKPOINTS</p>
      <h1>{strings.page.heading}</h1>
      <p>{strings.page.intro}</p>
    </header>

    <section
      class="sources-page__groups"
      aria-label={strings.page.groupsAriaLabel}
    >
      {
        groups.map((group) => {
          const records = sources.filter((source) =>
            group.kinds.includes(source.data.kind),
          );
          const sharedDate = sharedCheckedDate(records);
          return (
            <section
              class="source-group"
              aria-labelledby={`source-group-${group.id}`}
            >
              <div>
                <h2 id={`source-group-${group.id}`}>{group.title}</h2>
                <p>{group.description}</p>
                {sharedDate && (
                  <p class="source-group__checked">
                    {strings.allCheckedOn.replace('{date}', sharedDate)}
                  </p>
                )}
              </div>
              <ul>
                {records.map((source) => {
                  const translated = isSourceTranslated(source.id);
                  const nameLang = translated ? locale : DEFAULT_LOCALE;
                  const showNote = !translated && locale !== DEFAULT_LOCALE;
                  const usage = sourceUsage.get(source.id);
                  const hasMeta = showNote || !sharedDate || Boolean(usage);
                  return (
                    <li class="source-row">
                      {isSmsSource(source) ? (
                        <span class="source-group__message" lang={nameLang}>
                          {source.data.name}
                        </span>
                      ) : (
                        <a
                          href={source.data.url}
                          target="_blank"
                          rel="noreferrer"
                        >
                          <span lang={nameLang}>{source.data.name}</span>
                          <span class="sr-only">
                            {contentStrings.externalLink.newTab}
                          </span>
                        </a>
                      )}
                      {hasMeta && (
                        <div class="source-row__meta">
                          {showNote && (
                            <span class="source-group__untranslated">
                              {contentStrings.untranslatedSourceNote}
                            </span>
                          )}
                          {!sharedDate && (
                            <span>
                              {isSmsSource(source)
                                ? strings.receivedLabel
                                : strings.lastCheckedLabel}{' '}
                              {formatSeoulDate(sourceDate(source))}
                            </span>
                          )}
                          {usage && (
                            <div class="source-usage">
                              <span class="source-usage__label">
                                {strings.usedInLabel}
                              </span>
                              <ul
                                aria-label={strings.usedInAriaLabel.replace(
                                  '{name}',
                                  source.data.name,
                                )}
                              >
                                {usage.routes.map((route) => (
                                  <li>
                                    <a href={localeHref(locale, route)}>
                                      {routeLabels[route]}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          )}
                        </div>
                      )}
                    </li>
                  );
                })}
                {group.trailing && (
                  <li class="source-row">
                    <span class="source-group__reference">
                      {group.trailing.name}
                    </span>
                    <div class="source-row__meta">
                      <span>{group.trailing.note}</span>
                    </div>
                  </li>
                )}
              </ul>
            </section>
          );
        })
      }
    </section>

    <section
      class="sources-page__checkpoints"
      aria-labelledby="checkpoints-title"
    >
      <p class="eyebrow">UPDATE CALENDAR</p>
      <h2 id="checkpoints-title">{strings.checkpoints.heading}</h2>
      <ol>
        {
          checkpoints.map(([place, timing, action]) => (
            <li>
              <p>
                {place} · {timing}
              </p>
              <span>{action}</span>
            </li>
          ))
        }
      </ol>
      <p class="sources-page__note">{strings.checkpoints.archiveNote}</p>
      <p class="sources-page__note">{strings.checkpoints.coverNote}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .sources-page {
    display: grid;
    gap: var(--section-space);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .sources-page__hero,
  .source-group,
  .sources-page__checkpoints {
    border-top: 1px solid color-mix(in srgb, var(--ivory) 20%, transparent);
  }

  .sources-page__hero {
    display: grid;
    gap: 1rem;
    max-width: 50rem;
    padding-top: 2rem;
  }

  .sources-page__hero > p:last-child,
  .source-group > div > p,
  .sources-page__note {
    color: var(--mist);
  }

  .sources-page__groups {
    display: grid;
  }

  .source-group {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 2fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .source-group > div {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .source-group ul,
  .sources-page__checkpoints ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .source-group > ul {
    display: grid;
    gap: 0.75rem;
  }
  .source-row {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .source-row + .source-row {
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 16%, transparent);
  }
  .source-group a,
  .source-group__reference,
  .source-group__message {
    color: var(--ivory);
    font-weight: 800;
  }
  .source-group__checked {
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .source-group__untranslated {
    font-style: italic;
  }

  /* One muted line: "마지막 확인 09.21 · 사용 위치 홈 콘서트 가이드", wrapping only when needed. */
  .source-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    color: var(--ink-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .source-row__meta > * + *::before {
    content: '·';
    margin-inline: 0.5em;
  }

  .source-usage {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    align-items: baseline;
  }

  .source-usage__label {
    font-weight: 700;
  }

  .source-usage ul {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.7em;
  }

  .source-usage a {
    color: var(--amber);
    font-weight: 700;
  }

  .sources-page__checkpoints {
    display: grid;
    gap: 1rem;
    padding-top: var(--section-space);
  }

  .sources-page__checkpoints ol {
    display: grid;
    max-width: 56rem;
  }
  .sources-page__checkpoints li {
    display: grid;
    grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 1.15fr);
    gap: 0.5rem 1rem;
    padding-block: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ivory) 16%, transparent);
  }
  .sources-page__checkpoints li p {
    color: var(--ivory);
    font-weight: 800;
  }
  .sources-page__checkpoints li span {
    color: var(--mist);
  }

  @media (max-width: 42rem) {
    .source-group,
    .sources-page__checkpoints li {
      grid-template-columns: 1fr;
    }
  }
</style>
