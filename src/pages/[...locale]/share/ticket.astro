---
import TicketBuilder from '../../../components/share/TicketBuilder.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getConcert, getExpectedSetlist } from '../../../lib/content/queries';
import { localeFromParam, localePaths } from '../../../lib/i18n/routes';
import { ui } from '../../../lib/i18n/ui';
import { ARTIST } from '../../../lib/i18n/proper-nouns';

export const getStaticPaths = localePaths;

const locale = localeFromParam(Astro.params.locale);
const [concert, expectedSetlist] = await Promise.all([
  getConcert(),
  getExpectedSetlist(),
]);
const showDates = concert.data.shows.map((show) =>
  show.startsAt.slice(0, 10),
) as [string, string];
const showStarts = concert.data.shows.map((show) => show.startsAt) as [
  string,
  string,
];
const songs = expectedSetlist.map((entry) => entry.data.songTitle);
const strings = ui(locale).share.ticket.page;
const title = strings.title.replace('{artist}', ARTIST);
const description = strings.description.replace('{artist}', ARTIST);
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="shell-content">
    <TicketBuilder
      locale={locale}
      {showDates}
      {showStarts}
      {songs}
      shareUrl={Astro.url.toString()}
    />
  </div>
</BaseLayout>
