---
import SetlistCardBuilder from '../../../components/share/SetlistCardBuilder.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getConcert,
  getExpectedSetlist,
  getSetlistEditorialMetadata,
} from '../../../lib/content/queries';
import { localeFromParam, localePaths } from '../../../lib/i18n/routes';
import { ui } from '../../../lib/i18n/ui';
import { ARTIST } from '../../../lib/i18n/proper-nouns';

export const getStaticPaths = localePaths;

const locale = localeFromParam(Astro.params.locale);
const [concert, expectedSetlist] = await Promise.all([
  getConcert(locale),
  getExpectedSetlist(locale),
]);
const { version } = getSetlistEditorialMetadata(expectedSetlist);
const songs = expectedSetlist.map((entry) => entry.data.songTitle);
const strings = ui(locale).share.setlist.page;
const title = strings.title.replace('{artist}', ARTIST);
const description = strings.description.replace('{artist}', ARTIST);
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="shell-content">
    <SetlistCardBuilder
      locale={locale}
      {version}
      {songs}
      shareUrl={Astro.url.toString()}
      archivePublished={concert.data.archivePublished}
    />
  </div>
</BaseLayout>
