---
import { getCollection } from 'astro:content';
import AccessMap from '../components/guide/AccessMap.astro';
import AccessTable from '../components/guide/AccessTable.astro';
import DirectionsLinks from '../components/guide/DirectionsLinks.astro';
import GuideJumpNav from '../components/guide/GuideJumpNav.astro';
import GuideOverview from '../components/guide/GuideOverview.astro';
import GuideSection from '../components/guide/GuideSection.astro';
import LiveMap from '../components/guide/LiveMap.astro';
import SeatMap from '../components/guide/SeatMap.astro';
import TipsTabs from '../components/guide/TipsTabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGuideContent } from '../lib/content/queries';

const [guides, sources] = await Promise.all([
  getGuideContent(),
  getCollection('sources'),
]);
const tips = guides.filter((entry) => entry.data.section === 'tips');
const sections = guides.filter((entry) => entry.data.section !== 'tips');
const jump = [
  ...sections.map((entry) => ({
    id: entry.data.section,
    label: entry.data.title,
    order: entry.data.order,
  })),
  { id: 'tips', label: '현장 팁', order: tips[0]?.data.order ?? 30 },
].sort((a, b) => a.order - b.order);
const overviewItems = jump.map(({ id, label }) => {
  const entry =
    id === 'tips' ? tips[0] : sections.find((item) => item.data.section === id);
  if (!entry)
    throw new Error(`Missing guide metadata for overview section: ${id}`);
  return { id, label, status: entry.data.status };
});
---

<BaseLayout
  title="고양 가이드 | The Weeknd 고양 팬 가이드"
  description="The Weeknd 2026 고양 공연 당일 가이드 — 오는 길, 좌석 안내, 현장 팁, 귀가와 준비물"
>
  <section
    class="guide-page shell-content"
    aria-labelledby="goyang-guide-title"
  >
    <header>
      <p class="eyebrow">GOYANG DAY-OF GUIDE</p><h1 id="goyang-guide-title">
        고양 당일 가이드
      </h1><p>
        확정된 공연 정보와 아직 발표되지 않은 운영 정보를 분리해 두고, 다른 공연
        후기에서 반복된 경험은 따로 표시한 비공식 팬 가이드입니다.
      </p>
    </header>
    <GuideOverview items={overviewItems} />
    <div class="guide-body">
      <GuideJumpNav items={jump} />
      {
        sections.map((entry) => (
          <>
            <GuideSection entry={entry} sources={sources}>
              {entry.data.section === 'transport' && (
                <AccessTable slot="lead" />
              )}
              {entry.data.section === 'transport' && (
                <div class="guide-transport">
                  <AccessMap />
                  <DirectionsLinks />
                  <LiveMap />
                </div>
              )}
              {entry.data.section === 'seating' && <SeatMap />}
            </GuideSection>
            {entry.data.section === 'seating' && (
              <TipsTabs entries={tips} sources={sources} />
            )}
          </>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .guide-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .guide-page > *,
  .guide-page :global(.guide-body),
  .guide-page :global(.guide-body) > *,
  .guide-page :global(.guide-section),
  .guide-page :global(.guide-section__heading),
  .guide-page :global(.guide-section) > *,
  .guide-page :global(.access-table),
  .guide-page :global(.access-table) > *,
  .guide-page :global(.guide-overview),
  .guide-page :global(.guide-overview) > * {
    min-width: 0;
  }

  .guide-page :global(.guide-overview) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .guide-page :global(.guide-body) {
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }

  .guide-page :global(.guide-section) {
    grid-template-columns: minmax(0, 1fr);
  }

  .guide-page :global(.access-table__row) {
    grid-template-columns: minmax(0, 1fr);
  }

  .guide-page :global(.access-map),
  .guide-page :global(.directions),
  .guide-page :global(.live-map),
  .guide-page :global(.live-map__note) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .guide-page :global(.access-map img) {
    max-width: 100%;
  }

  .guide-page :global(.directions a) {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  header {
    display: grid;
    gap: 1rem;
    max-width: 58rem;
  }
  /* The jump nav sticks for the whole body, so a 9,000px page stays navigable
     without scrolling back to the top. Sections offset their anchors to clear it. */
  .guide-body {
    display: grid;
    gap: clamp(4rem, 11vw, 9rem);
  }
  :global(.guide-jump) {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    width: calc(100% + (var(--gutter) * 2));
    min-width: 0;
    gap: 0.5rem;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.6rem var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid color-mix(in srgb, var(--ivory) 14%, transparent);
    background: color-mix(in srgb, var(--night) 82%, transparent);
    backdrop-filter: blur(14px);
  }
  :global(.guide-jump::-webkit-scrollbar) {
    display: none;
  }
  @media (max-width: 44rem) {
    :global(.guide-jump) {
      scroll-padding-inline: var(--gutter) 3rem;
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 var(--gutter),
        #000 calc(100% - 3rem),
        transparent
      );
    }
  }
  :global(.guide-jump a) {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ivory) 24%, transparent);
    border-radius: 999px;
    color: var(--mist);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  :global(.guide-jump nav) {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
    min-width: 0;
    overflow-x: auto;
    width: 100%;
  }
  :global(.guide-jump a:hover),
  :global(.guide-jump a:focus-visible) {
    border-color: var(--amber);
    color: var(--ivory);
  }
  .guide-transport {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  header > p:last-child {
    max-width: 44rem;
    color: var(--mist);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
</style>
