---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FanNote from '../components/home/FanNote.astro';
import GuideShortcuts from '../components/home/GuideShortcuts.astro';
import HomeHero from '../components/home/HomeHero.astro';
import IntroSummary from '../components/home/IntroSummary.astro';
import SetlistPreview from '../components/home/SetlistPreview.astro';
import {
  getAlbums,
  getConcert,
  getExpectedSetlist,
  getSetlistEditorialMetadata,
} from '../lib/content/queries';
import { buildEventJsonLd, serializeJsonLd } from '../lib/seo/eventJsonLd';

const title = 'The Weeknd 고양 팬 가이드';
const concert = await getConcert();
const albums = await getAlbums();
const setlist = await getExpectedSetlist();
const { observationCount } = getSetlistEditorialMetadata(setlist);
const eventJsonLd = buildEventJsonLd(
  concert.data,
  (Astro.site ?? Astro.url).toString(),
);
const sources = await getCollection('sources');
const officialNoticeUrl = sources.find((source) => source.id === 'nol-notice')
  ?.data.url;
if (!officialNoticeUrl) throw new Error('Missing source record: nol-notice');
---

<BaseLayout
  title={title}
  description="The Weeknd 2026 고양 공연을 위한 비공식·비영리 팬 가이드"
  dawnSky
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(eventJsonLd)}
  />
  <HomeHero concert={concert} officialNoticeUrl={officialNoticeUrl} />
  <IntroSummary albums={albums} />
  <SetlistPreview entries={setlist} previewCount={6} {observationCount} />
  <GuideShortcuts />
  <FanNote />
  <script src="../scripts/home-motion.ts"></script>
</BaseLayout>
