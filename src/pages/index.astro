---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'The Weeknd 고양 팬 가이드';
---

<BaseLayout
  title={title}
  description="The Weeknd 2026 고양 공연을 위한 비공식·비영리 팬 가이드"
>
  <section class="home-intro shell-content" aria-labelledby="home-title">
    <p class="eyebrow">AFTER HOURS TIL DAWN / GOYANG</p>
    <h1 id="home-title">AFTER HOURS <span>TIL DAWN</span></h1>
    <p>2026.10.07—08 · 고양종합운동장 주경기장</p>
  </section>
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    align-content: center;
    min-height: min(66vh, 48rem);
    padding-block: var(--section-space);
  }

  h1 {
    max-width: 11ch;
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 18vw, 15rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 0.72;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    background: linear-gradient(
      90deg,
      var(--red),
      var(--blue) 64%,
      var(--amber)
    );
    background-clip: text;
    color: transparent;
  }

  h1 + p {
    max-width: 34rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    color: var(--mist);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
  }
</style>
